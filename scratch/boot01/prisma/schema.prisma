generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model TestBoot01Record {
  id        String   @id
  familyId  String   @map("family_id")
  version   Int
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([familyId, version], name: "uq_family_version")
  @@map("test_boot01_records")
}
