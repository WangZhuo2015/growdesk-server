+                                   "fixtureRequests": self.fixture.count()}
+        self.report["cases"].append({"name": "committed REST record queues a family notification task",
+                                      "passed": delta["familyTasks"] == 1, "expected": 1, "actual": delta["familyTasks"]})
+        assert delta["familyTasks"] == 1, "family_notification_task_missing"
+
