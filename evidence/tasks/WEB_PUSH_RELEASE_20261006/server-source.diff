+        zone, quiet, expected_due = self.quiet_window()
+        self.pref(True, baby=True, quiet=quiet, zone=zone)
+        event = self.event(self.feeding("quiet_before")["id"])
+        child = self.fanout(event)[0]
+        before = self.fixture.count()
+        self.once()
