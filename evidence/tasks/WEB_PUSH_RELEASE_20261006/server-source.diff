+    def pref(self, enabled=True, baby=False, quiet=None, zone="UTC", account=None):
+        return self.call("PUT", "/api/v1/me/notification-preferences", 200, {
+            "babyId": self.baby["id"] if baby else None, "timeZone": zone,
