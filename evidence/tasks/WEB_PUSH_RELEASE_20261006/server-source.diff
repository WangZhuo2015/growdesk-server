+)
+
+func clearPassportTTSTestEnv(t *testing.T) {
+	t.Helper()
+	for _, key := range []string{"GROWDESK_TTS_PROVIDER", "GROWDESK_TTS_BASE_URL", "GROWDESK_TTS_API_KEY", "GROWDESK_TTS_MODEL", "GROWDESK_TTS_VOICE", "GROWDESK_TTS_TIMEOUT_MS"} {
+		t.Setenv(key, "")
+	}
+}
+
+func TestPassportTTSConfigurationIsIndependentAndRequiresExplicitSharedProvider(t *testing.T) {
+	clearPassportTTSTestEnv(t)
+	common := nativeProviderConfig{Mode: "openai-compatible", Endpoint: "https://test-provider.invalid/v1/chat/completions", APIKey: "test_fake_ai_key", Timeout: time.Second}
+	if _, err := passportTTSConfiguration(common); err == nil {
+		t.Fatal("chat provider configuration silently inferred an audio route")
+	}
+	t.Setenv("GROWDESK_TTS_PROVIDER", "shared")
+	config, err := passportTTSConfiguration(common)
+	if err != nil || config.Endpoint != "https://test-provider.invalid/v1/audio/speech" || config.APIKey != common.APIKey || config.Model != "tts-1" || config.Voice != "alloy" {
+		t.Fatalf("explicit shared compatible provider failed: %#v, %v", config, err)
+	}
+
+	t.Setenv("GROWDESK_TTS_PROVIDER", "openai-compatible")
+	t.Setenv("GROWDESK_TTS_BASE_URL", "https://test-tts.invalid/v2")
+	t.Setenv("GROWDESK_TTS_API_KEY", "test_fake_tts_key")
+	t.Setenv("GROWDESK_TTS_MODEL", "test-speech-model")
+	t.Setenv("GROWDESK_TTS_VOICE", "test-voice")
+	config, err = passportTTSConfiguration(nativeProviderConfig{Mode: "not-compatible"})
+	if err != nil || config.Endpoint != "https://test-tts.invalid/v2/audio/speech" || config.APIKey != "test_fake_tts_key" || config.Model != "test-speech-model" || config.Voice != "test-voice" {
+		t.Fatalf("separate TTS configuration failed: %#v, %v", config, err)
+	}
+
+	t.Setenv("GROWDESK_TTS_PROVIDER", "")
+	t.Setenv("GROWDESK_TTS_BASE_URL", "")
+	t.Setenv("GROWDESK_TTS_API_KEY", "")
+	t.Setenv("GROWDESK_TTS_MODEL", "")
+	t.Setenv("GROWDESK_TTS_VOICE", "")
+	t.Setenv("GROWDESK_TTS_PROVIDER", "openai-compatible")
+	t.Setenv("GROWDESK_TTS_BASE_URL", "https://other-provider.invalid/v1")
+	if _, err = passportTTSConfiguration(nativeProviderConfig{Mode: "openai-compatible", Endpoint: "https://test-provider.invalid/v1/chat/completions", APIKey: "test_fake_common_key"}); err == nil {
+		t.Fatal("common provider key was reused for a different TTS endpoint")
+	}
+	t.Setenv("GROWDESK_TTS_PROVIDER", "")
+	t.Setenv("GROWDESK_TTS_BASE_URL", "https://TEST-PROVIDER.INVALID:443/v1")
+	if config, err = passportTTSConfiguration(common); err != nil || config.APIKey != common.APIKey {
+		t.Fatalf("same canonical endpoint did not reuse compatible provider config: %#v, %v", config, err)
+	}
+	t.Setenv("GROWDESK_TTS_BASE_URL", "")
+	if _, err = passportTTSConfiguration(nativeProviderConfig{Mode: "vendor-specific", Endpoint: common.Endpoint, APIKey: common.APIKey}); err == nil {
+		t.Fatal("non-compatible common provider was used as a TTS fallback")
+	}
+
+	t.Setenv("GROWDESK_TTS_PROVIDER", "fixture")
+	if _, err = passportTTSConfiguration(nativeProviderConfig{Mode: "openai-compatible"}); err == nil {
+		t.Fatal("TTS fixture was accepted without the explicit AI fixture mode")
+	}
+	if fixture, err := passportTTSConfiguration(nativeProviderConfig{Mode: "fixture", Fixture: `{"text":"test"}`}); err != nil || fixture.Mode != "fixture" {
+		t.Fatalf("existing explicit fixture mode was rejected: %#v, %v", fixture, err)
+	}
+}
+
+func TestPassportTTSEndpointRejectsCredentialsAndQuery(t *testing.T) {
+	for _, raw := range []string{
+		"https://test_user:test_pass@test.invalid/v1",
+		"https://test.invalid/v1?token=test_private",
+		"file:///tmp/test",
+		"https://test.invalid/v1#fragment",
+	} {
+		if _, err := passportTTSEndpoint(raw); err == nil {
+			t.Errorf("unsafe TTS endpoint accepted: %q", raw)
+		}
+	}
+}
+
+type passportTTSRoundTripper func(*http.Request) (*http.Response, error)
+
+func (roundTrip passportTTSRoundTripper) RoundTrip(request *http.Request) (*http.Response, error) {
+	return roundTrip(request)
+}
+
+type passportTTSObservedBody struct {
+	reader io.Reader
+	closed atomic.Bool
+}
+
+func (body *passportTTSObservedBody) Read(p []byte) (int, error) { return body.reader.Read(p) }
+func (body *passportTTSObservedBody) Close() error {
+	body.closed.Store(true)
+	return nil
+}
+
+type passportTTSObservedTransport struct {
+	passportTTSRoundTripper
+	closedIdle atomic.Bool
+}
+
+func (transport *passportTTSObservedTransport) CloseIdleConnections() {
+	transport.closedIdle.Store(true)
+}
+
+func TestPassportTTSProviderStatusIsSanitizedAndClosesResources(t *testing.T) {
+	body := &passportTTSObservedBody{reader: strings.NewReader(`{"text":"plausible but invalid transcript","secret":"test_private_response"}`)}
+	transport := &passportTTSObservedTransport{
+		passportTTSRoundTripper: func(request *http.Request) (*http.Response, error) {
+			if request.Header.Get("Authorization") != "Bearer test_fake_tts_key" {
+				t.Error("TTS authorization header was not set")
+			}
+			return &http.Response{StatusCode: http.StatusUnauthorized, Header: make(http.Header), Body: body, Request: request}, nil
+		},
+	}
+	client := &http.Client{Transport: transport}
+	request, err := http.NewRequest(http.MethodPost, "https://test-provider.invalid/v1/audio/speech", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	request.Header.Set("Authorization", "Bearer test_fake_tts_key")
+	_, err = synthesizePassportTTSWithClient(context.Background(), passportTTSConfig{}, request, client)
+	var providerErr *nativeProviderError
+	if !errors.As(err, &providerErr) || providerErr.Code != "TTS_PROVIDER_AUTH_FAILED" {
+		t.Fatalf("unexpected provider error: %#v", err)
+	}
+	if strings.Contains(err.Error(), "test_private_response") || strings.Contains(err.Error(), "test_fake_tts_key") {
+		t.Fatalf("provider details leaked in error: %v", err)
+	}
+	if !body.closed.Load() || !transport.closedIdle.Load() {
+		t.Fatalf("response/client resources were not closed: body=%v idle=%v", body.closed.Load(), transport.closedIdle.Load())
+	}
+	if event := passportTTSErrorEvent("test_turn", err); event["code"] != "TTS_PROVIDER_AUTH_FAILED" || event["turnId"] != "test_turn" {
+		t.Fatalf("device-facing error event lost TTS status: %#v", event)
+	}
+}
+
+func TestPassportTTSPCMValidationRejectsMalformedBodies(t *testing.T) {
+	testCases := []struct {
+		name        string
+		contentType string
+		body        []byte
+	}{
+		{name: "empty"},
+		{name: "odd PCM", contentType: "audio/pcm", body: []byte{1, 2, 3}},
+		{name: "oversize PCM", contentType: "audio/pcm", body: bytes.Repeat([]byte{1, 2}, maxPassportTTSOutputBytes/2+1)},
+		{name: "JSON", contentType: "application/json", body: []byte(`{"error":"test_private"}`)},
+		{name: "WAV instead of raw PCM", contentType: "audio/wav", body: []byte("RIFF0000WAVE")},
+		{name: "network-order L16", contentType: "audio/L16", body: []byte{1, 2}},
+		{name: "wrong sample rate", contentType: "audio/pcm; rate=16000", body: []byte{1, 2}},
+		{name: "stereo", contentType: "audio/pcm; channels=2", body: []byte{1, 2}},
+		{name: "big endian", contentType: "audio/pcm; endianness=big", body: []byte{1, 2}},
+	}
+	for _, testCase := range testCases {
+		t.Run(testCase.name, func(t *testing.T) {
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+				if testCase.contentType != "" {
+					w.Header().Set("Content-Type", testCase.contentType)
+				}
+				_, _ = w.Write(testCase.body)
+			}))
+			defer server.Close()
+			config := passportTTSConfig{Mode: "openai-compatible", Endpoint: server.URL, APIKey: "test_fake_key", Timeout: time.Second}
+			pcm, err := synthesizePassportTTS(context.Background(), config, "test words")
+			var providerErr *nativeProviderError
+			if pcm != nil || !errors.As(err, &providerErr) || providerErr.Code != "TTS_PROVIDER_INVALID_RESPONSE" {
+				t.Fatalf("invalid PCM accepted: len=%d err=%v", len(pcm), err)
+			}
+		})
+	}
+}
+
+func TestPassportTTSTimeoutAndCancellation(t *testing.T) {
+	releaseTimeoutHandler := make(chan struct{})
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, request *http.Request) {
+		select {
+		case <-request.Context().Done():
+		case <-releaseTimeoutHandler:
+		}
+	}))
+	defer server.Close()
+	defer close(releaseTimeoutHandler)
+	config := passportTTSConfig{Mode: "openai-compatible", Endpoint: server.URL, APIKey: "test_fake_key", Timeout: 100 * time.Millisecond}
+	_, err := synthesizePassportTTS(context.Background(), config, "test words")
+	var providerErr *nativeProviderError
+	if !errors.As(err, &providerErr) || providerErr.Code != "TTS_PROVIDER_TIMEOUT" {
+		t.Fatalf("provider timeout was not typed: %v", err)
+	}
+
+	started := make(chan struct{})
+	releaseCancelHandler := make(chan struct{})
+	cancelServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, request *http.Request) {
+		close(started)
+		select {
+		case <-request.Context().Done():
+		case <-releaseCancelHandler:
+		}
+	}))
+	defer cancelServer.Close()
+	defer close(releaseCancelHandler)
+	ctx, cancel := context.WithCancel(context.Background())
+	cancelConfig := config
+	cancelConfig.Endpoint = cancelServer.URL
+	done := make(chan error, 1)
+	go func() {
+		_, requestErr := synthesizePassportTTS(ctx, cancelConfig, "test words")
+		done <- requestErr
+	}()
+	select {
+	case <-started:
+	case <-time.After(time.Second):
+		t.Fatal("cancellation request did not reach the virtual provider")
+	}
+	cancel()
+	select {
+	case err = <-done:
+		if !errors.Is(err, context.Canceled) {
+			t.Fatalf("caller cancellation was not preserved: %v", err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("cancelled TTS request did not stop")
+	}
+}
+
+func TestPassportTTSFailureDoesNotStartPlayback(t *testing.T) {
+	clearPassportTTSTestEnv(t)
+	t.Setenv("GROWDESK_TTS_PROVIDER", "shared")
+	for _, testCase := range []struct {
+		name        string
+		status      int
+		contentType string
+		body        []byte
+		wantCode    string
+	}{
+		{name: "HTTP failure", status: http.StatusBadGateway, body: []byte("test_private_provider_response"), wantCode: "TTS_PROVIDER_HTTP_ERROR"},
+		{name: "malformed PCM", status: http.StatusOK, contentType: "audio/pcm", body: []byte{1, 2, 3}, wantCode: "TTS_PROVIDER_INVALID_RESPONSE"},
+	} {
+		t.Run(testCase.name, func(t *testing.T) {
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+				if testCase.contentType != "" {
+					w.Header().Set("Content-Type", testCase.contentType)
+				}
+				w.WriteHeader(testCase.status)
+				_, _ = w.Write(testCase.body)
+			}))
+			defer server.Close()
+			common := nativeProviderConfig{Mode: "openai-compatible", Endpoint: server.URL + "/v1/chat/completions", APIKey: "test_fake_key", Timeout: time.Second}
+			var events []Object
+			var audio [][]byte
+			(&Server{}).streamPassportTTS(context.Background(), common, "test_turn", "test spoken text", func(value any) error {
+				events = append(events, obj(value))
+				return nil
+			}, func(value []byte) error {
+				audio = append(audio, append([]byte(nil), value...))
+				return nil
+			})
+			if len(events) != 1 || events[0]["type"] != "error" || events[0]["code"] != testCase.wantCode || len(audio) != 0 {
+				t.Fatalf("failed provider incorrectly started playback: events=%#v audio=%d", events, len(audio))
+			}
+		})
+	}
+}
+
+func TestPassportTTSValidPCMStreamsWithExistingWireFormat(t *testing.T) {
+	clearPassportTTSTestEnv(t)
+	t.Setenv("GROWDESK_TTS_PROVIDER", "shared")
+	pcm := bytes.Repeat([]byte{0x34, 0x12}, 1010)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, request *http.Request) {
+		if request.URL.Path != "/v1/audio/speech" {
+			t.Errorf("unexpected TTS endpoint: %s", request.URL.Path)
+		}
+		if request.Header.Get("Authorization") != "Bearer test_fake_key" {
+			t.Error("wrong provider authorization")
+		}
+		var payload map[string]any
+		if err := json.NewDecoder(request.Body).Decode(&payload); err != nil {
+			t.Errorf("invalid TTS JSON: %v", err)
+		}
+		if payload["model"] != "tts-1" || payload["voice"] != "alloy" || payload["response_format"] != "pcm" || payload["input"] != "test spoken text" {
+			t.Errorf("unexpected TTS request: %#v", payload)
+		}
+		w.Header().Set("Content-Type", "audio/pcm")
+		_, _ = w.Write(pcm)
+	}))
+	defer server.Close()
+	common := nativeProviderConfig{Mode: "openai-compatible", Endpoint: server.URL + "/v1/chat/completions", APIKey: "test_fake_key", Timeout: time.Second}
+	var events []Object
+	var audio [][]byte
+	(&Server{}).streamPassportTTS(context.Background(), common, "test_turn", "test spoken text", func(value any) error {
+		events = append(events, obj(value))
+		return nil
+	}, func(value []byte) error {
+		audio = append(audio, append([]byte(nil), value...))
+		return nil
+	})
+	if len(events) != 2 || events[0]["type"] != "tts.start" || events[1]["type"] != "tts.end" {
+		t.Fatalf("unexpected event sequence: %#v", events)
+	}
+	format := obj(events[0]["audioFormat"])
+	if format["codec"] != "pcm_s16le" || format["sampleRate"] != 24000 || format["channels"] != 1 {
+		t.Fatalf("PCM wire format changed: %#v", format)
+	}
+	var joined []byte
+	for _, chunk := range audio {
+		if len(chunk) == 0 || len(chunk)%2 != 0 {
+			t.Fatalf("invalid PCM chunk size: %d", len(chunk))
+		}
+		joined = append(joined, chunk...)
+	}
+	if !bytes.Equal(joined, pcm) || len(audio) != 2 {
+		t.Fatalf("PCM stream mismatch: chunks=%d bytes=%d", len(audio), len(joined))
+	}
+}
+
+func TestPassportTTSFixtureRequiresExistingOptInAndEmitsSilence(t *testing.T) {
+	clearPassportTTSTestEnv(t)
+	var events []Object
+	var audio [][]byte
+	(&Server{}).streamPassportTTS(context.Background(), nativeProviderConfig{Mode: "fixture", Fixture: `{"text":"test"}`}, "test_turn", "test words", func(value any) error {
+		events = append(events, obj(value))
+		return nil
+	}, func(value []byte) error {
+		audio = append(audio, append([]byte(nil), value...))
+		return nil
+	})
+	if len(events) != 2 || events[0]["type"] != "tts.start" || events[1]["type"] != "tts.end" || len(audio) != 3 {
+		t.Fatalf("explicit fixture output mismatch: events=%#v audio=%d", events, len(audio))
+	}
+	total := 0
+	for _, chunk := range audio {
+		if len(chunk)%2 != 0 {
+			t.Fatal("fixture chunk was not aligned to PCM samples")
+		}
+		total += len(chunk)
+		for _, sample := range chunk {
+			if sample != 0 {
+				t.Fatal("fixture audio was not silence")
+			}
+		}
+	}
+	if total != 4800 {
+		t.Fatalf("fixture silence changed size: %d", total)
+	}
+}
+
+func TestPassportTTSPacingMatchesPCMPlaybackDuration(t *testing.T) {
+	if got := passportTTSChunkDuration(1920); got != 40*time.Millisecond {
+		t.Fatalf("1920 PCM bytes should represent 40 ms, got %s", got)
+	}
+	if got := passportTTSChunkDuration(960); got != 20*time.Millisecond {
+		t.Fatalf("960 PCM bytes should represent 20 ms, got %s", got)
+	}
+	if got := passportTTSPacingDelay(1920, 12*time.Millisecond); got != 28*time.Millisecond {
+		t.Fatalf("write time was not included in the pacing interval: %s", got)
+	}
+	if got := passportTTSPacingDelay(1920, 45*time.Millisecond); got != 0 {
+		t.Fatalf("slow writes should not add more pacing delay: %s", got)
+	}
+	if got := passportTTSChunkDuration(3); got != 0 {
+		t.Fatalf("odd byte counts cannot form 16-bit PCM samples: %s", got)
+	}
+}
+
+func TestPassportTTSCancelDuringPlaybackSendsNoStaleErrorOrEnd(t *testing.T) {
+	clearPassportTTSTestEnv(t)
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	var events []Object
+	firstChunk := true
+	(&Server{}).streamPassportTTS(ctx, nativeProviderConfig{Mode: "fixture", Fixture: `{"text":"test"}`}, "test_turn", "test words", func(value any) error {
+		events = append(events, obj(value))
+		return nil
+	}, func(value []byte) error {
+		if firstChunk {
+			firstChunk = false
+			cancel()
+		}
+		return nil
+	})
+	if len(events) != 1 || events[0]["type"] != "tts.start" {
+		t.Fatalf("cancelled playback emitted a stale error or end event: %#v", events)
+	}
+}
diff --git a/internal/backend/passport_turns.go b/internal/backend/passport_turns.go
new file mode 100644
index 0000000..fb1134c
--- /dev/null
+++ b/internal/backend/passport_turns.go
@@ -0,0 +1,84 @@
+package backend
+
+import (
+	"context"
+	"github.com/gorilla/websocket"
+	"sync"
+)
+
+const passportMaxFrameBytes = 16 * 1024
+const passportReplayWindow = 128
+
+func configurePassportSocket(conn *websocket.Conn) { conn.SetReadLimit(passportMaxFrameBytes) }
+
+func passportAudioEndTurn(current, requested string) (string, error) {
+	if requested == "" {
+		requested = current
+	}
+	if current == "" || requested != current {
+		return "", invalid("Audio end does not match the active recording")
+	}
+	return current, nil
+}
+
+type passportReplay struct{ ids []string }
+
+func (r *passportReplay) accept(id string) (bool, error) {
+	if len(id) == 0 || len(id) > 64 {
+		return false, invalid("Voice turn ID must contain 1 to 64 bytes")
+	}
+	for _, seen := range r.ids {
+		if seen == id {
+			return false, nil
+		}
+	}
+	if len(r.ids) == passportReplayWindow {
+		r.ids = r.ids[1:]
+	}
+	r.ids = append(r.ids, id)
+	return true, nil
+}
+
+type passportTurnGate struct {
+	mu      sync.Mutex
+	current *passportTurnTicket
+}
+type passportTurnTicket struct {
+	gate   *passportTurnGate
+	ctx    context.Context
+	cancel context.CancelFunc
+}
+
+func (g *passportTurnGate) replace(ctx context.Context) *passportTurnTicket {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	if g.current != nil {
+		g.current.cancel()
+	}
+	turnCtx, cancel := context.WithCancel(ctx)
+	t := &passportTurnTicket{gate: g, ctx: turnCtx, cancel: cancel}
+	g.current = t
+	return t
+}
+
+func (g *passportTurnGate) stop() {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	if g.current != nil {
+		g.current.cancel()
+		g.current = nil
+	}
+}
+
+// Serialize publishing a reply/proposal against replacement by a new recording.
+func (t *passportTurnTicket) publish(ctx context.Context, fn func() error) error {
+	t.gate.mu.Lock()
+	defer t.gate.mu.Unlock()
+	if t.gate.current != t || t.ctx.Err() != nil {
+		return context.Canceled
+	}
+	if ctx.Err() != nil {
+		return ctx.Err()
+	}
+	return fn()
+}
diff --git a/internal/backend/passport_turns_test.go b/internal/backend/passport_turns_test.go
new file mode 100644
index 0000000..ae95287
--- /dev/null
+++ b/internal/backend/passport_turns_test.go
@@ -0,0 +1,121 @@
+package backend
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"github.com/gorilla/websocket"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestPassportAudioEndMustMatchActiveRecording(t *testing.T) {
+	for _, id := range []string{"", "test_active"} {
+		got, err := passportAudioEndTurn("test_active", id)
+		if got != "test_active" || err != nil {
+			t.Fatal("valid end rejected", got, err)
+		}
+	}
+	if _, err := passportAudioEndTurn("test_active", "test_other"); err == nil {
+		t.Fatal("mismatched audio end relabeled recording")
+	}
+}
+
+func TestPassportSocketRejectsOversizedMessageBeforeReadingBody(t *testing.T) {
+	done := make(chan error, 1)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		conn, err := (&websocket.Upgrader{}).Upgrade(w, r, nil)
+		if err != nil {
+			done <- err
+			return
+		}
+		defer conn.Close()
+		configurePassportSocket(conn)
+		_, _, err = conn.ReadMessage()
+		done <- err
+	}))
+	defer server.Close()
+	conn, _, err := websocket.DefaultDialer.Dial("ws"+strings.TrimPrefix(server.URL, "http"), nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	if err = conn.WriteMessage(websocket.BinaryMessage, make([]byte, passportMaxFrameBytes+1)); err != nil {
+		t.Fatal(err)
+	}
+	if err = <-done; !errors.Is(err, websocket.ErrReadLimit) {
+		t.Fatal("oversized frame read without the transport budget", err)
+	}
+}
+
+func TestPassportReplayIsBoundedAndRejectsBadIDs(t *testing.T) {
+	var replay passportReplay
+	if _, err := replay.accept(strings.Repeat("x", 65)); err == nil {
+		t.Fatal("oversized ID accepted")
+	}
+	for n := 0; n < passportReplayWindow*3; n++ {
+		id := fmt.Sprintf("test_turn_%d", n)
+		ok, err := replay.accept(id)
+		if !ok || err != nil {
+			t.Fatal("new turn rejected", err)
+		}
+		if dup, _ := replay.accept(id); dup {
+			t.Fatal("duplicate turn accepted")
+		}
+		if len(replay.ids) > passportReplayWindow {
+			t.Fatal("unbounded replay state")
+		}
+	}
+}
+
+func TestPassportTurnReplacementPreventsStalePublication(t *testing.T) {
+	var gate passportTurnGate
+	old := gate.replace(context.Background())
+	current := gate.replace(context.Background())
+	defer gate.stop()
+	if err := old.publish(old.ctx, func() error { t.Fatal("old turn published a reply/proposal"); return nil }); err != context.Canceled {
+		t.Fatal("old turn was not cancelled", err)
+	}
+	called := false
+	if err := current.publish(current.ctx, func() error { called = true; return nil }); err != nil || !called {
+		t.Fatal("current reply rejected", err)
+	}
+	gate.stop()
+	if err := current.publish(context.Background(), func() error { t.Fatal("stopped turn published"); return nil }); err != context.Canceled {
+		t.Fatal("stopped turn accepted", err)
+	}
+}
+
+func TestPassportTurnReplacementWaitsForInFlightPublication(t *testing.T) {
+	var gate passportTurnGate
+	old := gate.replace(context.Background())
+	defer gate.stop()
+	entered, release := make(chan struct{}), make(chan struct{})
+	published, replaced := make(chan error, 1), make(chan *passportTurnTicket, 1)
+	go func() {
+		published <- old.publish(old.ctx, func() error { close(entered); <-release; return nil })
+	}()
+	<-entered
+	go func() { replaced <- gate.replace(context.Background()) }()
+	select {
+	case <-replaced:
+		close(release)
+		t.Fatal("replacement invalidated a reply while publication held the gate")
+	case <-time.After(50 * time.Millisecond):
+	}
+	close(release)
+	if err := <-published; err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case current := <-replaced:
+		if old.ctx.Err() != context.Canceled || current.ctx.Err() != nil {
+			t.Fatal("turn replacement did not transfer ownership")
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("replacement remained stuck after publication")
+	}
+}
diff --git a/internal/backend/passport_voice_catalog.go b/internal/backend/passport_voice_catalog.go
new file mode 100644
index 0000000..96e44d6
--- /dev/null
+++ b/internal/backend/passport_voice_catalog.go
@@ -0,0 +1,114 @@
+package backend
+
+import (
+	"context"
+	"errors"
+	"strings"
+	"time"
+	"unicode/utf8"
+
+	"github.com/jackc/pgx/v5"
+)
+
+// Catalog data is scoped by the verified device and current baby membership;
+// model-provided identifiers never establish access to a family's food items.
+func (s *Server) loadPassportVoiceCatalog(ctx context.Context, principal *PassportPrincipal) ([]Object, error) {
+	if principal == nil || !time.Now().Before(principal.ExpiresAt) {
+		return nil, apiError(401, "INVALID_PASSPORT_TOKEN", "Passport token is expired")
+	}
+	var active bool
+	if err := s.DB.QueryRow(ctx, `SELECT EXISTS(SELECT 1 FROM passport_devices
+		WHERE id=$1 AND owner_user_id=$2 AND family_id=$3 AND baby_id=$4 AND revoked_at IS NULL)`,
+		principal.DeviceID, principal.OwnerUserID, principal.FamilyID, principal.BabyID).Scan(&active); err != nil {
+		return nil, err
+	}
+	if !active {
+		return nil, apiError(403, "DEVICE_ACCESS_REVOKED", "Device access has been revoked or its scope has changed")
+	}
+	scope, err := babyScope(ctx, s.DB, principal.OwnerUserID, principal.BabyID, false)
+	if err != nil {
+		return nil, err
+	}
+	if scope.FamilyID != principal.FamilyID {
+		return nil, apiError(403, "BABY_SCOPE_MISMATCH", "Device baby scope has changed")
+	}
+	rows, err := s.DB.Query(ctx, `SELECT id,name FROM food_library_items
+		WHERE family_id IS NULL OR family_id=$1 ORDER BY is_custom DESC,name,id LIMIT 128`, scope.FamilyID)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	catalog := make([]Object, 0)
+	bytes := 0
+	for rows.Next() {
+		var id, name string
+		if err := rows.Scan(&id, &name); err != nil {
+			return nil, err
+		}
+		bytes += len(id) + len(name)
+		if bytes > 32*1024 {
+			break
+		}
+		catalog = append(catalog, Object{"id": id, "name": name})
+	}
+	return catalog, rows.Err()
+}
+
+func (s *Server) hydratePassportFoodCard(ctx context.Context, principal *PassportPrincipal, projection *passportCardProjection) error {
+	if projection == nil || projection.Action.EntityType != "food" {
+		return nil
+	}
+	ids, ok := projection.Action.Payload["foodItemIds"].([]any)
+	if !ok || len(ids) == 0 {
+		return providerFailure("INVALID_RECORD_PROPOSAL", "Select at least one real food item before confirmation", false)
+	}
+	names := make([]string, 0, len(ids))
+	for _, raw := range ids {
+		id, ok := raw.(string)
+		if !ok {
+			return providerFailure("INVALID_RECORD_PROPOSAL", "Food identifiers are invalid", false)
+		}
+		var name string
+		if err := s.DB.QueryRow(ctx, `SELECT name FROM food_library_items WHERE id=$1 AND (family_id IS NULL OR family_id=$2)`, id, principal.FamilyID).Scan(&name); err != nil {
+			return providerFailure("INVALID_RECORD_PROPOSAL", "A proposed food item is unavailable in this family", false)
+		}
+		names = append(names, name)
+	}
+	value := strings.Join(names, "、")
+	if utf8.RuneCountInString(value) > passportMaxCardValue {
+		return providerFailure("INVALID_RECORD_PROPOSAL", "Food names exceed the device display limit; submit fewer items", false)
+	}
+	for i := range projection.Card.Fields {
+		if projection.Card.Fields[i].Label == "食物" || projection.Card.Fields[i].Label == "食物 ID" {
+			projection.Card.Fields[i].Label = "食物"
+			projection.Card.Fields[i].Value = value
+			return nil
+		}
+	}
+	return providerFailure("INVALID_RECORD_PROPOSAL", "Food proposal has no display field", false)
+}
+
+// Called by the command's Apply closure after the receipt replay check, while
+// the same record transaction/family lock is held. Row locks keep references
+// valid through commit, including public catalog rows without a family lock.
+func validatePassportFoodReferences(ctx context.Context, tx pgx.Tx, familyID string, payload Object) error {
+	ids, ok := payload["foodItemIds"].([]any)
+	if !ok || len(ids) == 0 {
+		return invalid("Select at least one real food item")
+	}
+	for _, raw := range ids {
+		id, ok := raw.(string)
+		if !ok || strings.TrimSpace(id) == "" {
+			return invalid("Food identifiers are invalid")
+		}
+		var found string
+		err := tx.QueryRow(ctx, `SELECT id FROM food_library_items WHERE id=$1 AND (family_id IS NULL OR family_id=$2) FOR SHARE`, id, familyID).Scan(&found)
+		if errors.Is(err, pgx.ErrNoRows) {
+			return apiError(400, "FOOD_ITEM_NOT_FOUND", "A proposed food item is unavailable in this family")
+		}
+		if err != nil {
+			return err
+		}
+	}
+	return nil
+}
diff --git a/internal/backend/passport_voice_diagnostics.go b/internal/backend/passport_voice_diagnostics.go
new file mode 100644
index 0000000..250b494
--- /dev/null
+++ b/internal/backend/passport_voice_diagnostics.go
@@ -0,0 +1,98 @@
+package backend
+
+import (
+	"context"
+	"strings"
+	"time"
+)
+
+// Speech diagnostics deliberately contain only stage, typed status and numeric
+// transport evidence. Do not add transcript, reply, credentials or raw errors.
+type passportSpeechDiagnostic struct {
+	phase         string
+	code          string
+	provider      string
+	pcmBytes      int
+	sentBytes     int
+	chunks        int
+	peakAmplitude int
+	started       time.Time
+}
+
+func (s *Server) logPassportVoiceEvent(value any) {
+	if s.Log == nil {
+		return
+	}
+	event, ok := value.(Object)
+	if !ok {
+		return
+	}
+	typeName, _ := event["type"].(string)
+	switch typeName {
+	case "asr.final", "assistant.final":
+		content, _ := event["text"].(string)
+		s.Log.Info("passport voice event", "type", typeName, "textBytes", len(content))
+	case "error":
+		code, _ := event["code"].(string)
+		s.Log.Info("passport voice event", "type", typeName, "code", safePassportVoiceCode(code))
+	}
+}
+
+func safePassportVoiceCode(code string) string {
+	if len(code) == 0 || len(code) > 64 {
+		return "UNCLASSIFIED_ERROR"
+	}
+	for _, character := range code {
+		if (character < 'A' || character > 'Z') && (character < '0' || character > '9') && character != '_' {
+			return "UNCLASSIFIED_ERROR"
+		}
+	}
+	for _, prefix := range []string{"ASR_", "AI_", "TTS_", "WS_", "QUERY_", "VOICE_", "CARD_", "INVALID_", "DEVICE_", "BABY_SCOPE_"} {
+		if strings.HasPrefix(code, prefix) {
+			return code
+		}
+	}
+	switch code {
+	case "UNAUTHORIZED", "FORBIDDEN", "TOKEN_EXPIRED":
+		return code
+	}
+	return "UNCLASSIFIED_ERROR"
+}
+
+func (diagnostic *passportSpeechDiagnostic) failure(phase string, err error) {
+	diagnostic.phase = phase
+	diagnostic.code, _ = passportTTSErrorEvent("", err)["code"].(string)
+}
+
+func (diagnostic *passportSpeechDiagnostic) sendFailure(ctx context.Context, phase string) {
+	if ctx.Err() != nil {
+		diagnostic.failure(phase, ctx.Err())
+		return
+	}
+	diagnostic.phase, diagnostic.code = phase, "WS_AUDIO_SEND_FAILED"
+}
+
+func (s *Server) logPassportSpeechOutcome(diagnostic *passportSpeechDiagnostic) {
+	if s.Log == nil {
+		return
+	}
+	s.Log.Info("passport speech outcome", "phase", diagnostic.phase,
+		"code", diagnostic.code, "provider", diagnostic.provider,
+		"pcmBytes", diagnostic.pcmBytes, "sentBytes", diagnostic.sentBytes,
+		"chunks", diagnostic.chunks, "peakAmplitude", diagnostic.peakAmplitude,
+		"elapsedMs", time.Since(diagnostic.started).Milliseconds())
+}
+
+func passportPCMPeak(pcm []byte) int {
+	peak := 0
+	for offset := 0; offset+1 < len(pcm); offset += 2 {
+		sample := int(int16(uint16(pcm[offset]) | uint16(pcm[offset+1])<<8))
+		if sample < 0 {
+			sample = -sample
+		}
+		if sample > peak {
+			peak = sample
+		}
+	}
+	return peak
+}
diff --git a/internal/backend/passport_voice_diagnostics_test.go b/internal/backend/passport_voice_diagnostics_test.go
new file mode 100644
index 0000000..18b1deb
--- /dev/null
+++ b/internal/backend/passport_voice_diagnostics_test.go
@@ -0,0 +1,126 @@
+package backend
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"log/slog"
+	"strings"
+	"testing"
+)
+
+func TestPassportTTSDiagnosticsExposeOutcomeWithoutReplyOrCredentials(t *testing.T) {
+	for _, configured := range []bool{false, true} {
+		t.Run(map[bool]string{false: "configuration failure", true: "complete"}[configured], func(t *testing.T) {
+			clearPassportTTSTestEnv(t)
+			if configured {
+				t.Setenv("GROWDESK_TTS_PROVIDER", "fixture")
+			}
+			var output bytes.Buffer
+			server := &Server{Log: slog.New(slog.NewJSONHandler(&output, nil))}
+			common := nativeProviderConfig{Mode: "openai-compatible", APIKey: "test_private_key"}
+			if configured {
+				common.Mode = "fixture"
+			}
+			server.streamPassportTTS(context.Background(), common, "test_turn", "test_private_reply", func(any) error { return nil }, func([]byte) error { return nil })
+			if strings.Contains(output.String(), "test_private_reply") || strings.Contains(output.String(), "test_private_key") {
+				t.Fatal("TTS diagnostic exposed reply or credentials")
+			}
+			var event Object
+			if err := json.Unmarshal(output.Bytes(), &event); err != nil {
+				t.Fatalf("expected one machine-readable TTS outcome: %v, output=%q", err, output.String())
+			}
+			if event["msg"] != "passport speech outcome" {
+				t.Fatalf("missing speech outcome: %#v", event)
+			}
+			if configured {
+				if event["phase"] != "complete" || event["pcmBytes"] != float64(4800) || event["sentBytes"] != float64(4800) || event["chunks"] != float64(3) || event["peakAmplitude"] != float64(0) {
+					t.Fatalf("incomplete PCM transport evidence: %#v", event)
+				}
+			} else if event["phase"] != "configuration" || event["code"] != "TTS_PROVIDER_NOT_CONFIGURED" || event["sentBytes"] != float64(0) {
+				t.Fatalf("configuration failure not diagnosable: %#v", event)
+			}
+		})
+	}
+}
+
+func TestPassportTTSDiagnosticsClassifyCancelledAndFailedStreams(t *testing.T) {
+	for _, scenario := range []string{"write failure", "cancel", "cancel and write failure"} {
+		t.Run(scenario, func(t *testing.T) {
+			clearPassportTTSTestEnv(t)
+			t.Setenv("GROWDESK_TTS_PROVIDER", "fixture")
+			var output bytes.Buffer
+			server := &Server{Log: slog.New(slog.NewJSONHandler(&output, nil))}
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			errorEvents := 0
+			server.streamPassportTTS(ctx, nativeProviderConfig{Mode: "fixture"}, "test_turn", "test_private_reply", func(value any) error {
+				if event, ok := value.(Object); ok && event["type"] == "error" {
+					errorEvents++
+				}
+				return nil
+			}, func([]byte) error {
+				if scenario != "write failure" {
+					cancel()
+					if scenario == "cancel and write failure" {
+						return errors.New("test_private_closed_socket")
+					}
+					return nil
+				}
+				return errors.New("test_private_transport_error")
+			})
+			var event Object
+			if err := json.Unmarshal(output.Bytes(), &event); err != nil {
+				t.Fatal(err)
+			}
+			if strings.Contains(output.String(), "test_private") || event["phase"] != "stream" || event["pcmBytes"] != float64(4800) {
+				t.Fatalf("unsafe or missing stream diagnostics: %#v", event)
+			}
+			if scenario != "write failure" {
+				if errorEvents != 0 {
+					t.Fatal("cancelled turn attempted to send an error")
+				}
+				expectedBytes, expectedChunks := float64(1920), float64(1)
+				if scenario == "cancel and write failure" {
+					expectedBytes, expectedChunks = 0, 0
+				}
+				if event["code"] != "TTS_PROVIDER_CANCELLED" || event["sentBytes"] != expectedBytes || event["chunks"] != expectedChunks {
+					t.Fatalf("cancelled transport counted unsent PCM: %#v", event)
+				}
+			} else if event["code"] != "WS_AUDIO_SEND_FAILED" || event["sentBytes"] != float64(0) || event["chunks"] != float64(0) {
+				t.Fatalf("failed write counted as sent: %#v", event)
+			}
+			if scenario == "write failure" && errorEvents != 1 {
+				t.Fatal("live transport failure did not attempt one typed error")
+			}
+		})
+	}
+}
+
+func TestPassportPCMPeakHandlesSilenceAndSignedExtremes(t *testing.T) {
+	if passportPCMPeak([]byte{0, 0, 0, 0}) != 0 || passportPCMPeak([]byte{255, 127, 0, 128}) != 32768 {
+		t.Fatal("PCM amplitude evidence lost signed extrema")
+	}
+}
+
+func TestPassportVoiceEventDiagnosticsOmitAllContent(t *testing.T) {
+	var output bytes.Buffer
+	server := &Server{Log: slog.New(slog.NewJSONHandler(&output, nil))}
+	server.logPassportVoiceEvent(Object{"type": "asr.final", "text": "test_private_transcript", "turnId": "test_private_turn"})
+	server.logPassportVoiceEvent(Object{"type": "assistant.final", "text": "test_private_reply"})
+	server.logPassportVoiceEvent(Object{"type": "error", "code": "ASR_PROVIDER_NO_SPEECH", "message": "test_private_message"})
+	server.logPassportVoiceEvent(Object{"type": "error", "code": "test_private_raw_error"})
+	server.logPassportVoiceEvent(Object{"type": "unknown", "text": "test_private_other"})
+	if strings.Contains(output.String(), "test_private") {
+		t.Fatal("voice diagnostics logged personal data or arbitrary error text")
+	}
+	lines := strings.Split(strings.TrimSpace(output.String()), "\n")
+	if len(lines) != 4 {
+		t.Fatalf("unexpected event count: %d", len(lines))
+	}
+	var last Object
+	if err := json.Unmarshal([]byte(lines[3]), &last); err != nil || last["code"] != "UNCLASSIFIED_ERROR" {
+		t.Fatalf("untrusted code was not classified: %#v %v", last, err)
+	}
+}
diff --git a/internal/backend/passport_voice_query_integration_test.go b/internal/backend/passport_voice_query_integration_test.go
new file mode 100644
index 0000000..4939068
--- /dev/null
+++ b/internal/backend/passport_voice_query_integration_test.go
@@ -0,0 +1,183 @@
+package backend
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/gorilla/websocket"
+)
+
+type passportVoiceQueryProviderObservation struct {
+	body             []byte
+	authorizedMarker bool
+	foreignMarker    bool
+}
+
+// This is an isolated end-to-end feedback loop for the exact symptom: a
+// committed, authorized record exists, but the model answers that no record is
+// available. Its PostgreSQL rows are created through the real confirmation
+// transaction and its voice request passes the Passport JWT/WebSocket handler.
+func TestPassportVoiceRecordQueryContextDiagnostic(t *testing.T) {
+	clearSpeechTestEnvironment(t)
+	for _, name := range []string{
+		"GROWDESK_TTS_PROVIDER", "GROWDESK_TTS_BASE_URL", "GROWDESK_TTS_API_KEY",
+		"GROWDESK_TTS_MODEL", "GROWDESK_TTS_VOICE", "GROWDESK_TTS_TIMEOUT_MS",
+	} {
+		t.Setenv(name, "")
+	}
+
+	const authorizedAnswer = "test_one_authorized_record"
+	const noDataAnswer = "test_no_record_context"
+	authorizedMarker := "test_passport_voice_query_authorized_" + strings.ReplaceAll(newID(), "-", "")
+	foreignMarker := "test_passport_voice_query_foreign_" + strings.ReplaceAll(newID(), "-", "")
+	observations := make(chan passportVoiceQueryProviderObservation, 2)
+	provider := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		switch r.URL.Path {
+		case "/v1/audio/transcriptions":
+			w.Header().Set("Content-Type", "application/json")
+			_, _ = io.WriteString(w, `{"text":"今天宝宝喝了多少奶？"}`)
+		case "/v1/chat/completions":
+			body, err := io.ReadAll(io.LimitReader(r.Body, 2*1024*1024))
+			if err != nil {
+				http.Error(w, "test provider could not read request", http.StatusBadRequest)
+				return
+			}
+			authorized := bytes.Contains(body, []byte(authorizedMarker))
+			foreign := bytes.Contains(body, []byte(foreignMarker))
+			observations <- passportVoiceQueryProviderObservation{body: body, authorizedMarker: authorized, foreignMarker: foreign}
+			answer := noDataAnswer
+			if authorized && !foreign {
+				answer = authorizedAnswer
+			}
+			content, _ := json.Marshal(Object{"text": answer, "actions": []any{}})
+			response := Object{"choices": []any{Object{"message": Object{"content": string(content)}}}}
+			w.Header().Set("Content-Type", "application/json")
+			_ = json.NewEncoder(w).Encode(response)
+		case "/v1/audio/speech":
+			w.Header().Set("Content-Type", "audio/pcm; rate=24000; channels=1; bits=16; endianness=little")
+			_, _ = w.Write([]byte{0, 0})
+		default:
+			http.NotFound(w, r)
+		}
+	}))
+	defer provider.Close()
+
+	t.Setenv("GROWDESK_AI_PROVIDER", "openai-compatible")
+	t.Setenv("GROWDESK_AI_BASE_URL", provider.URL+"/v1")
+	t.Setenv("GROWDESK_AI_API_KEY", "test_local_query_ai_key")
+	t.Setenv("GROWDESK_AI_MODEL", "test_local_query_model")
+	t.Setenv("GROWDESK_ASR_PROVIDER", "openai-compatible")
+	t.Setenv("GROWDESK_ASR_BASE_URL", provider.URL+"/v1")
+	t.Setenv("GROWDESK_ASR_API_KEY", "test_local_query_asr_key")
+	t.Setenv("GROWDESK_ASR_MODEL", "test_local_query_asr")
+	t.Setenv("GROWDESK_TTS_PROVIDER", "openai-compatible")
+	t.Setenv("GROWDESK_TTS_BASE_URL", provider.URL+"/v1")
+	t.Setenv("GROWDESK_TTS_API_KEY", "test_local_query_tts_key")
+
+	h := newPassportConfirmationPG(t)
+	fx := newPassportConfirmationFixture(t, h.controlDB)
+	other := newPassportConfirmationFixture(t, h.controlDB)
+	if _, err := h.controlDB.Exec(context.Background(), `UPDATE families SET timezone='America/Los_Angeles' WHERE id=$1`, fx.familyID); err != nil {
+		t.Fatalf("set isolated family timezone: %v", err)
+	}
+	location, err := time.LoadLocation("America/Los_Angeles")
+	if err != nil {
+		t.Fatal(err)
+	}
+	recordedAt := time.Now().In(location).Format(time.RFC3339Nano)
+	createRecord := func(fixture *passportConfirmationFixture, amount, note string) string {
+		t.Helper()
+		actionID, runID := newID(), newID()
+		planHash := "test_plan_" + newID()
+		action := nativeAIAction{
+			ActionID: actionID, EntityType: "feeding", Operation: "create",
+			Summary: "Test Passport feeding record",
+			Payload: Object{"feedingType": "formula", "amountMl": amount, "occurredAt": recordedAt, "notes": note},
+		}
+		ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+		defer cancel()
+		id, err := h.server.executePassportCardConfirmation(ctx, fixture.principal, runID, planHash, actionID, planHash, action, time.Now().Add(2*time.Minute))
+		if err != nil || id == "" {
+			t.Fatalf("seed isolated Passport record through confirmation transaction: id=%q err=%v", id, err)
+		}
+		return id
+	}
+	createdID := createRecord(fx, "145.5", authorizedMarker)
+	foreignID := createRecord(other, "999", foreignMarker)
+	var note string
+	if err := h.controlDB.QueryRow(context.Background(), `SELECT notes FROM feeding_records WHERE id=$1 AND family_id=$2 AND baby_id=$3 AND deleted_at IS NULL`, createdID, fx.familyID, fx.babyID).Scan(&note); err != nil || note != authorizedMarker {
+		t.Fatalf("verify committed authorized test row before voice query: note=%q err=%v", note, err)
+	}
+	if err := h.controlDB.QueryRow(context.Background(), `SELECT notes FROM feeding_records WHERE id=$1 AND family_id=$2 AND baby_id=$3 AND deleted_at IS NULL`, foreignID, other.familyID, other.babyID).Scan(&note); err != nil || note != foreignMarker {
+		t.Fatalf("verify committed foreign-family test row before voice query: note=%q err=%v", note, err)
+	}
+	loadedContext, loadErr := h.server.loadPassportVoiceRecordContextForKinds(context.Background(), fx.principal, time.Now().UTC(), []string{"feeding"})
+	if loadErr != nil {
+		t.Fatalf("direct read of authorized Passport record context failed: %v", loadErr)
+	}
+	if !loadedContext.HasAnyRecords || loadedContext.TotalRecordCount != 1 || loadedContext.RecentRecordCount != 1 {
+		t.Fatalf("authorized test record context counts = total %d recent %d", loadedContext.TotalRecordCount, loadedContext.RecentRecordCount)
+	}
+	t.Logf("loaded read context: total=%d recent=%d truncated=%t timezone=%s", loadedContext.TotalRecordCount, loadedContext.RecentRecordCount, loadedContext.Truncated, loadedContext.TimeZone)
+
+	const jwtSecret = "test_passport_record_query_signing_key"
+	h.server.Config.JWTSecret = jwtSecret
+	token := passportShortTurnTestToken(t, fx, jwtSecret)
+	wsServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path != "/api/v1/passport/ws" {
+			http.NotFound(w, r)
+			return
+		}
+		result, err := h.server.handlePassportWebSocket(r.Context(), &Request{HTTP: r})
+		if err != nil {
+			h.server.writeError(w, err, "test_passport_voice_query_context")
+			return
+		}
+		if result.Stream == nil {
+			http.Error(w, "websocket stream missing", http.StatusInternalServerError)
+			return
+		}
+		if err := result.Stream(w); err != nil {
+			return
+		}
+	}))
+	defer wsServer.Close()
+	wsURL := "ws" + strings.TrimPrefix(wsServer.URL, "http") + "/api/v1/passport/ws"
+	conn, response, err := websocket.DefaultDialer.Dial(wsURL, http.Header{"Authorization": []string{"Bearer " + token}})
+	if err != nil {
+		if response != nil {
+			response.Body.Close()
+		}
+		t.Fatalf("connect through real Passport JWT/WebSocket handler: %v", err)
+	}
+	defer conn.Close()
+
+	// One short but non-silent device frame stays below the real 16 KiB WS limit.
+	pcm := make([]byte, 1600)
+	pcm[0] = 1
+	sendPassportTestVoiceTurn(t, conn, "test_voice_query_today", pcm)
+	asr := readPassportTestWSEvent(t, conn)
+	if asr["type"] != "asr.final" || asr["text"] != "今天宝宝喝了多少奶？" {
+		t.Fatalf("isolated voice query ASR result = %#v", asr)
+	}
+	answer := readPassportTestWSEvent(t, conn)
+	if answer["type"] != "assistant.final" {
+		t.Fatalf("isolated voice query did not produce assistant.final: %#v", answer)
+	}
+	var observed passportVoiceQueryProviderObservation
+	select {
+	case observed = <-observations:
+	case <-time.After(2 * time.Second):
+		t.Fatal("local fake chat provider did not receive the voice query")
+	}
+	if !observed.authorizedMarker || observed.foreignMarker || answer["text"] != authorizedAnswer {
+		t.Fatalf("voice query returned %q although an authorized test feeding row was committed; provider_payload_has_authorized_record=%t provider_payload_has_foreign_family_record=%t", answer["text"], observed.authorizedMarker, observed.foreignMarker)
+	}
+}
diff --git a/internal/backend/passport_voice_records.go b/internal/backend/passport_voice_records.go
new file mode 100644
index 0000000..f508004
--- /dev/null
+++ b/internal/backend/passport_voice_records.go
@@ -0,0 +1,555 @@
+package backend
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"log/slog"
+	"strings"
+	"time"
+)
+
+const (
+	passportVoiceRecordWindowDays      = 7
+	passportVoiceRecordLimit           = 12
+	passportVoiceRecordContextMaxBytes = 24 * 1024
+)
+
+type passportVoiceRecordContext struct {
+	Data              Object
+	TimeZone          string
+	TotalRecordCount  int64
+	RecentRecordCount int64
+	Truncated         bool
+	HasAnyRecords     bool
+}
+
+type passportVoiceRecordSpec struct {
+	kind        string
+	table       string
+	dayExpr     string
+	windowField string
+	timeBased   bool
+	selectJSON  string
+	dayValue    string
+}
+
+// Every identifier and projected field below is a source-code constant. The
+// only dynamic values in the generated SQL are bound parameters.
+var passportVoiceRecordSpecs = []passportVoiceRecordSpec{
+	{
+		kind: "feeding", table: "feeding_records", dayExpr: "(occurred_at AT TIME ZONE $3::text)::date", windowField: "occurred_at", timeBased: true,
+		selectJSON: `jsonb_build_object(
+			'localDate', (r.occurred_at AT TIME ZONE $3::text)::date::text,
+			'occurredAt', r.occurred_at,
+			'feedingType', r.feeding_type,
+			'amountMl', r.amount_ml::text,
+			'leftMinutes', r.left_minutes,
+			'rightMinutes', r.right_minutes,
+			'spitUp', r.spit_up,
+			'notes', left(r.notes, 160))`,
+		dayValue: "SUM(amount_ml)::text",
+	},
+	{
+		kind: "sleep", table: "sleep_records", dayExpr: "(started_at AT TIME ZONE $3::text)::date", windowField: "started_at", timeBased: true,
+		selectJSON: `jsonb_build_object(
+			'localDate', (r.started_at AT TIME ZONE $3::text)::date::text,
+			'startedAt', r.started_at,
+			'endedAt', r.ended_at,
+			'sleepType', r.sleep_type,
+			'nightWakingCount', r.night_waking_count,
+			'notes', left(r.notes, 160))`,
+	},
+	{
+		kind: "diaper", table: "diaper_records", dayExpr: "(occurred_at AT TIME ZONE $3::text)::date", windowField: "occurred_at", timeBased: true,
+		selectJSON: `jsonb_build_object(
+			'localDate', (r.occurred_at AT TIME ZONE $3::text)::date::text,
+			'occurredAt', r.occurred_at,
+			'diaperType', r.diaper_type,
+			'poopColor', left(r.poop_color, 40),
+			'poopConsistency', left(r.poop_consistency, 40),
+			'notes', left(r.notes, 160))`,
+	},
+	{
+		kind: "food", table: "food_records", dayExpr: "record_date", windowField: "record_date",
+		selectJSON: `jsonb_build_object(
+			'localDate', r.record_date,
+			'occurredAt', r.occurred_at,
+			'mealType', r.meal_type,
+			'foods', coalesce((SELECT jsonb_agg(authorized_food.name ORDER BY authorized_food.name)
+				FROM (SELECT left(fi.name, 64) AS name FROM food_library_items fi
+					WHERE fi.id = ANY(r.food_item_ids) AND (fi.family_id IS NULL OR fi.family_id = $1)
+					ORDER BY fi.name LIMIT 8) authorized_food), '[]'::jsonb),
+			'portionDescription', left(r.portion_description, 80),
+			'reaction', r.reaction,
+			'notes', left(r.notes, 160))`,
+	},
+	{
+		kind: "supplement", table: "supplement_records", dayExpr: "(occurred_at AT TIME ZONE $3::text)::date", windowField: "occurred_at", timeBased: true,
+		selectJSON: `jsonb_build_object(
+			'localDate', (r.occurred_at AT TIME ZONE $3::text)::date::text,
+			'occurredAt', r.occurred_at,
+			'supplementName', left(r.supplement_name, 64),
+			'amount', left(r.amount, 64),
+			'dose', r.dose::text,
+			'unitName', left(r.unit_name, 32),
+			'notes', left(r.notes, 160))`,
+	},
+	{
+		kind: "growth", table: "growth_measurements", dayExpr: "measurement_date", windowField: "measurement_date",
+		selectJSON: `jsonb_build_object(
+			'localDate', r.measurement_date::text,
+			'weightKg', r.weight_kg::text,
+			'heightCm', r.height_cm::text,
+			'headCircumferenceCm', r.head_circumference_cm::text,
+			'notes', left(r.notes, 160))`,
+	},
+}
+
+func (s *Server) loadPassportVoiceRecordContextForKinds(ctx context.Context, principal *PassportPrincipal, reference time.Time, kinds []string) (passportVoiceRecordContext, error) {
+	var result passportVoiceRecordContext
+	if s.DB == nil {
+		return result, errors.New("passport record database unavailable")
+	}
+	specs := selectPassportVoiceRecordSpecs(kinds)
+	if len(specs) == 0 {
+		return result, errors.New("no Passport record types selected")
+	}
+	if principal == nil || !time.Now().Before(principal.ExpiresAt) {
+		return result, apiError(401, "INVALID_PASSPORT_TOKEN", "Passport token is expired")
+	}
+	if reference.IsZero() {
+		reference = time.Now().UTC()
+	}
+
+	_, err := s.readSnapshot(ctx, func(q Querier) (Result, error) {
+		var active bool
+		if err := q.QueryRow(ctx, `SELECT EXISTS(SELECT 1 FROM passport_devices
+			WHERE id=$1 AND owner_user_id=$2 AND family_id=$3 AND baby_id=$4 AND revoked_at IS NULL)`,
+			principal.DeviceID, principal.OwnerUserID, principal.FamilyID, principal.BabyID).Scan(&active); err != nil {
+			return Result{}, err
+		}
+		if !active {
+			return Result{}, apiError(403, "DEVICE_ACCESS_REVOKED", "Device access has been revoked or its scope has changed")
+		}
+		scope, err := babyScope(ctx, q, principal.OwnerUserID, principal.BabyID, false)
+		if err != nil {
+			return Result{}, err
+		}
+		if scope.FamilyID != principal.FamilyID {
+			return Result{}, apiError(403, "BABY_SCOPE_MISMATCH", "Device baby scope has changed")
+		}
+		var timezone string
+		if err := q.QueryRow(ctx, `SELECT timezone FROM families WHERE id=$1 AND deleted_at IS NULL`, scope.FamilyID).Scan(&timezone); err != nil {
+			return Result{}, err
+		}
+		location, err := time.LoadLocation(timezone)
+		if err != nil {
+			return Result{}, fmt.Errorf("invalid family timezone: %w", err)
+		}
+
+		windowStartLocal := reference.In(location)
+		windowStartLocal = time.Date(windowStartLocal.Year(), windowStartLocal.Month(), windowStartLocal.Day(), 0, 0, 0, 0, location).AddDate(0, 0, -(passportVoiceRecordWindowDays - 1))
+		windowEndLocal := windowStartLocal.AddDate(0, 0, passportVoiceRecordWindowDays)
+		windowStartDate := windowStartLocal.Format("2006-01-02")
+		windowEndDate := windowEndLocal.Format("2006-01-02")
+		window := passportVoiceRecordWindow{
+			familyID: scope.FamilyID, babyID: scope.BabyID, timezone: timezone,
+			startAt: windowStartLocal.UTC(), endAt: windowEndLocal.UTC(),
+			startDate: windowStartDate, endDate: windowEndDate, startLocal: windowStartLocal,
+		}
+		data := Object{
+			"timeZone": timezone,
+			"recentWindow": Object{
+				"startDate": windowStartDate,
+				"endDate":   windowEndLocal.AddDate(0, 0, -1).Format("2006-01-02"),
+				"dayCount":  passportVoiceRecordWindowDays,
+			},
+			"recordTypes": Object{},
+		}
+		byKind := obj(data["recordTypes"])
+		selectedKinds := make([]string, 0, len(specs))
+		for _, spec := range specs {
+			kindData, err := loadPassportVoiceRecordKind(ctx, q, spec, window)
+			if err != nil {
+				return Result{}, fmt.Errorf("load Passport %s context: %w", spec.kind, err)
+			}
+			byKind[spec.kind] = kindData.data
+			result.TotalRecordCount += kindData.allTimeCount
+			result.RecentRecordCount += kindData.recentCount
+			result.Truncated = result.Truncated || kindData.truncated
+			selectedKinds = append(selectedKinds, spec.kind)
+		}
+		data["includedRecordTypes"] = selectedKinds
+		contextTruncated, err := boundPassportVoiceRecordContext(data)
+		if err != nil {
+			return Result{}, err
+		}
+		result.Truncated = result.Truncated || contextTruncated
+		result.Data = data
+		result.TimeZone = timezone
+		result.HasAnyRecords = result.TotalRecordCount > 0
+		return ok(Object{})
+	})
+	if err != nil {
+		return passportVoiceRecordContext{}, err
+	}
+	return result, nil
+}
+
+// loadPassportVoiceTimeZone reads only the authorized family's timezone for
+// non-data turns. It deliberately does not load any historical baby records.
+func (s *Server) loadPassportVoiceTimeZone(ctx context.Context, principal *PassportPrincipal) (string, error) {
+	if s.DB == nil {
+		return "", errors.New("passport timezone database unavailable")
+	}
+	if principal == nil || !time.Now().Before(principal.ExpiresAt) {
+		return "", apiError(401, "INVALID_PASSPORT_TOKEN", "Passport token is expired")
+	}
+	var timezone string
+	_, err := s.readSnapshot(ctx, func(q Querier) (Result, error) {
+		var active bool
+		if err := q.QueryRow(ctx, `SELECT EXISTS(SELECT 1 FROM passport_devices
+			WHERE id=$1 AND owner_user_id=$2 AND family_id=$3 AND baby_id=$4 AND revoked_at IS NULL)`,
+			principal.DeviceID, principal.OwnerUserID, principal.FamilyID, principal.BabyID).Scan(&active); err != nil {
+			return Result{}, err
+		}
+		if !active {
+			return Result{}, apiError(403, "DEVICE_ACCESS_REVOKED", "Device access has been revoked or its scope has changed")
+		}
+		scope, err := babyScope(ctx, q, principal.OwnerUserID, principal.BabyID, false)
+		if err != nil {
+			return Result{}, err
+		}
+		if scope.FamilyID != principal.FamilyID {
+			return Result{}, apiError(403, "BABY_SCOPE_MISMATCH", "Device baby scope has changed")
+		}
+		if err := q.QueryRow(ctx, `SELECT timezone FROM families WHERE id=$1 AND deleted_at IS NULL`, scope.FamilyID).Scan(&timezone); err != nil {
+			return Result{}, err
+		}
+		if _, err := time.LoadLocation(timezone); err != nil {
+			return Result{}, fmt.Errorf("invalid family timezone: %w", err)
+		}
+		return ok(Object{})
+	})
+	if err != nil {
+		return "", err
+	}
+	return timezone, nil
+}
+
+func passportAllPassportVoiceRecordKinds() []string {
+	kinds := make([]string, 0, len(passportVoiceRecordSpecs))
+	for _, spec := range passportVoiceRecordSpecs {
+		kinds = append(kinds, spec.kind)
+	}
+	return kinds
+}
+
+func selectPassportVoiceRecordSpecs(kinds []string) []passportVoiceRecordSpec {
+	requested := make(map[string]struct{}, len(kinds))
+	for _, kind := range kinds {
+		requested[kind] = struct{}{}
+	}
+	selected := make([]passportVoiceRecordSpec, 0, len(requested))
+	for _, spec := range passportVoiceRecordSpecs {
+		if _, ok := requested[spec.kind]; ok {
+			selected = append(selected, spec)
+		}
+	}
+	return selected
+}
+
+func boundPassportVoiceRecordContext(data Object) (bool, error) {
+	serialized, err := jsonText(data)
+	if err != nil {
+		return false, err
+	}
+	if len(serialized) <= passportVoiceRecordContextMaxBytes {
+		return false, nil
+	}
+	recordTypes := obj(data["recordTypes"])
+	kinds, _ := data["includedRecordTypes"].([]string)
+	for _, kind := range kinds {
+		recent := obj(obj(recordTypes[kind])["recentWindow"])
+		samples, _ := recent["samples"].([]Object)
+		for _, sample := range samples {
+			delete(sample, "notes")
+		}
+	}
+	serialized, err = jsonText(data)
+	if err != nil {
+		return false, err
+	}
+	for len(serialized) > passportVoiceRecordContextMaxBytes {
+		removedAny := false
+		for _, kind := range kinds {
+			recent := obj(obj(recordTypes[kind])["recentWindow"])
+			samples, _ := recent["samples"].([]Object)
+			if len(samples) == 0 {
+				continue
+			}
+			samples = samples[:len(samples)-1]
+			recentCount := int64(0)
+			if value, ok := recent["recordCount"].(int64); ok {
+				recentCount = value
+			}
+			recent["samples"] = samples
+			recent["includedRecordCount"] = len(samples)
+			recent["truncated"] = recentCount > int64(len(samples))
+			removedAny = true
+		}
+		if !removedAny {
+			return false, errors.New("passport record metadata exceeds its context budget")
+		}
+		serialized, err = jsonText(data)
+		if err != nil {
+			return false, err
+		}
+	}
+	return true, nil
+}
+
+func passportVoiceRecordQueryKinds(transcript string) []string {
+	text := strings.ToLower(strings.TrimSpace(transcript))
+	if text == "" {
+		return nil
+	}
+	for _, prefix := range []string{"记录", "请记录", "请帮我记录", "帮我记录", "帮我记", "记一下", "记下", "新增", "添加", "保存", "录入", "登记", "补记", "补录", "我刚喂", "我刚才喂", "我刚喝", "我刚才喝"} {
+		if strings.HasPrefix(text, prefix) {
+			return nil
+		}
+	}
+	for _, action := range []string{"记录一下", "记一下", "记下", "记下来", "记录下来", "补记", "补录", "新增", "添加", "保存", "录入", "登记"} {
+		if strings.Contains(text, action) {
+			return nil
+		}
+	}
+	for _, request := range []string{
+		"想记录", "想记", "要记录", "要记", "需要记录", "需要记", "准备记录", "准备记",
+		"想新增", "要新增", "需要新增", "请新增", "帮我新增", "想添加", "要添加", "需要添加", "请添加", "帮我添加",
+		"想保存", "要保存", "需要保存", "请保存", "帮我保存", "想补记", "要补记", "需要补记", "请补记", "帮我补记",
+		"请帮我记录", "帮我记录", "请记录", "帮忙记录", "麻烦记录", "我记录", "我补记", "我新增", "我添加", "我保存",
+	} {
+		if strings.Contains(text, request) {
+			return nil
+		}
+	}
+	for _, phrase := range []string{"怎么操作", "怎样操作", "如何操作", "怎么使用", "如何使用", "设备怎么用", "介绍一下设备", "怎么记录", "怎样记录", "如何记录", "教我记录", "介绍如何记录", "介绍怎样记录", "记录失败", "为什么", "应该喝多少奶", "需要喝多少奶", "建议喝多少奶", "正常喝多少奶", "怎么清洗", "如何清洗", "清洗奶瓶", "怎么冲奶", "如何冲奶", "怎么泡奶", "应该", "需要", "建议", "合适", "适合", "推荐", "能不能", "可不可以", "怎样才能", "怎么才能", "如何才能", "多睡吗"} {
+		if strings.Contains(text, phrase) {
+			return nil
+		}
+	}
+	queryIntent := false
+	for _, marker := range []string{"多少", "几次", "几天", "几觉", "几顿", "几餐", "多久", "多长时间", "什么时候", "哪一天", "最近一次", "上一次", "最后一次", "有没有", "统计", "列出", "总结", "回顾", "查询", "查一下", "查查", "查看", "看看", "看一下", "数据", "情况", "怎么样", "历史", "发生过", "吃了什么", "喝了多少奶"} {
+		if strings.Contains(text, marker) {
+			queryIntent = true
+			break
+		}
+	}
+	if !queryIntent {
+		return nil
+	}
+
+	typeTerms := map[string][]string{
+		"feeding":    {"喂养", "喂奶", "喝奶", "吃奶", "奶量", "喝了多少奶", "feeding", "milk"},
+		"sleep":      {"睡眠", "睡觉", "睡了多久", "睡了多长", "入睡", "sleep", "nap"},
+		"diaper":     {"尿布", "尿尿", "大便", "排便", "便便", "diaper", "pee", "poop"},
+		"food":       {"辅食", "吃了什么", "吃了啥", "食物", "food", "solid"},
+		"supplement": {"补充剂", "维生素", "维d", "补剂", "supplement", "vitamin"},
+		"growth":     {"成长", "生长", "身高", "体重", "头围", "growth", "weight", "height"},
+	}
+	selected := make([]string, 0, len(typeTerms))
+	for _, spec := range passportVoiceRecordSpecs {
+		for _, term := range typeTerms[spec.kind] {
+			if strings.Contains(text, term) {
+				selected = append(selected, spec.kind)
+				break
+			}
+		}
+	}
+	if len(selected) > 0 {
+		if queryIntent {
+			return selected
+		}
+		return nil
+	}
+	if queryIntent {
+		for _, marker := range []string{"数据", "情况", "历史", "记录"} {
+			if strings.Contains(text, marker) {
+				return passportAllPassportVoiceRecordKinds()
+			}
+		}
+	}
+	if queryIntent {
+		for _, marker := range []string{"总结", "回顾"} {
+			if strings.Contains(text, marker) {
+				return passportAllPassportVoiceRecordKinds()
+			}
+		}
+	}
+	return nil
+}
+
+type passportVoiceRecordKindResult struct {
+	data         Object
+	allTimeCount int64
+	recentCount  int64
+	truncated    bool
+}
+
+type passportVoiceRecordWindow struct {
+	familyID, babyID, timezone string
+	startAt, endAt             time.Time
+	startDate, endDate         string
+	startLocal                 time.Time
+}
+
+func loadPassportVoiceRecordKind(ctx context.Context, q Querier, spec passportVoiceRecordSpec, window passportVoiceRecordWindow) (passportVoiceRecordKindResult, error) {
+	var result passportVoiceRecordKindResult
+	where := `family_id=$1 AND baby_id=$2 AND deleted_at IS NULL`
+	aggregateQuery := fmt.Sprintf(`SELECT COUNT(*)::bigint, MIN(%s)::text, MAX(%s)::text FROM %s WHERE %s`, spec.dayExpr, spec.dayExpr, spec.table, where)
+	var earliest, latest *string
+	aggregateArgs := []any{window.familyID, window.babyID}
+	if spec.timeBased {
+		aggregateArgs = append(aggregateArgs, window.timezone)
+	}
+	if err := q.QueryRow(ctx, aggregateQuery, aggregateArgs...).Scan(&result.allTimeCount, &earliest, &latest); err != nil {
+		return result, err
+	}
+
+	recentWhere := where + " AND " + passportVoiceRecordWindowExpression(spec, 3, 4)
+	recentArgs := passportVoiceRecordWindowArgs(spec, window, false)
+	if err := q.QueryRow(ctx, fmt.Sprintf(`SELECT COUNT(*)::bigint FROM %s WHERE %s`, spec.table, recentWhere), recentArgs...).Scan(&result.recentCount); err != nil {
+		return result, err
+	}
+
+	dailyStartParameter := 3
+	if spec.timeBased {
+		dailyStartParameter = 4
+	}
+	dailyWhere := where + " AND " + passportVoiceRecordWindowExpression(spec, dailyStartParameter, dailyStartParameter+1)
+	dailyArgs := passportVoiceRecordWindowArgs(spec, window, spec.timeBased)
+	dailyQuery := fmt.Sprintf(`SELECT jsonb_build_object('date', (%s)::text, 'recordCount', COUNT(*)::bigint, 'valueTotal', %s)
+		FROM %s WHERE %s GROUP BY %s ORDER BY %s`, spec.dayExpr, dailyValueExpression(spec), spec.table, dailyWhere, spec.dayExpr, spec.dayExpr)
+	dailyRows, err := many(ctx, q, dailyQuery, dailyArgs...)
+	if err != nil {
+		return result, err
+	}
+	dailyByDate := make(map[string]Object, len(dailyRows))
+	for _, row := range dailyRows {
+		dailyByDate[text(row["date"])] = row
+	}
+
+	sampleArgs := passportVoiceRecordWindowArgs(spec, window, spec.timeBased)
+	sampleStartParameter := 3
+	if spec.timeBased {
+		sampleStartParameter = 4
+	}
+	sampleQuery := fmt.Sprintf(`SELECT %s FROM %s r WHERE r.family_id=$1 AND r.baby_id=$2 AND r.deleted_at IS NULL AND %s
+		ORDER BY %s DESC, r.id DESC LIMIT %d`, spec.selectJSON, spec.table, qualifiedPassportVoiceRecordWindowExpression(spec, sampleStartParameter, sampleStartParameter+1), qualifiedDayExpression(spec), passportVoiceRecordLimit)
+	samples, err := many(ctx, q, sampleQuery, sampleArgs...)
+	if err != nil {
+		return result, err
+	}
+	result.truncated = result.recentCount > int64(len(samples))
+
+	dailyTotals := make([]Object, 0, passportVoiceRecordWindowDays)
+	for day := 0; day < passportVoiceRecordWindowDays; day++ {
+		date := window.startLocal.AddDate(0, 0, day).Format("2006-01-02")
+		if entry, exists := dailyByDate[date]; exists {
+			value := Object{"date": date, "recordCount": entry["recordCount"]}
+			if entry["valueTotal"] != nil {
+				if spec.kind == "feeding" {
+					value["amountMl"] = entry["valueTotal"]
+				}
+			}
+			dailyTotals = append(dailyTotals, value)
+		} else {
+			dailyTotals = append(dailyTotals, Object{"date": date, "recordCount": int64(0)})
+		}
+	}
+
+	allTime := Object{"count": result.allTimeCount, "earliestDate": nil, "latestDate": nil}
+	if earliest != nil {
+		allTime["earliestDate"] = *earliest
+	}
+	if latest != nil {
+		allTime["latestDate"] = *latest
+	}
+	recent := Object{
+		"recordCount":         result.recentCount,
+		"includedRecordCount": len(samples),
+		"truncated":           result.truncated,
+		"samples":             samples,
+		"dailyTotals":         dailyTotals,
+	}
+	result.data = Object{"allTime": allTime, "recentWindow": recent}
+	return result, nil
+}
+
+func passportVoiceRecordWindowExpression(spec passportVoiceRecordSpec, startParameter, endParameter int) string {
+	if spec.timeBased {
+		return fmt.Sprintf("%s >= $%d::timestamptz AND %s < $%d::timestamptz", spec.windowField, startParameter, spec.windowField, endParameter)
+	}
+	if spec.kind == "food" {
+		return fmt.Sprintf("%s >= $%d::text AND %s < $%d::text", spec.windowField, startParameter, spec.windowField, endParameter)
+	}
+	return fmt.Sprintf("%s >= $%d::date AND %s < $%d::date", spec.windowField, startParameter, spec.windowField, endParameter)
+}
+
+func passportVoiceRecordWindowArgs(spec passportVoiceRecordSpec, window passportVoiceRecordWindow, includeTimeZone bool) []any {
+	args := []any{window.familyID, window.babyID}
+	if includeTimeZone {
+		args = append(args, window.timezone)
+	}
+	if spec.timeBased {
+		args = append(args, window.startAt, window.endAt)
+	} else {
+		args = append(args, window.startDate, window.endDate)
+	}
+	return args
+}
+
+func dailyValueExpression(spec passportVoiceRecordSpec) string {
+	if spec.dayValue == "" {
+		return "NULL::text"
+	}
+	return spec.dayValue
+}
+
+func qualifiedWindowExpression(spec passportVoiceRecordSpec) string {
+	return qualifiedPassportVoiceRecordWindowExpression(spec, 4, 5)
+}
+
+func qualifiedPassportVoiceRecordWindowExpression(spec passportVoiceRecordSpec, startParameter, endParameter int) string {
+	window := passportVoiceRecordWindowExpression(spec, startParameter, endParameter)
+	for _, column := range []string{"occurred_at", "started_at", "record_date", "measurement_date"} {
+		window = replaceSQLIdentifier(window, column, "r."+column)
+	}
+	return window
+}
+
+func qualifiedDayExpression(spec passportVoiceRecordSpec) string {
+	expression := spec.dayExpr
+	for _, column := range []string{"occurred_at", "started_at", "record_date", "measurement_date"} {
+		expression = replaceSQLIdentifier(expression, column, "r."+column)
+	}
+	return expression
+}
+
+func replaceSQLIdentifier(query, old, replacement string) string {
+	return strings.ReplaceAll(query, old, replacement)
+}
+
+func (s *Server) logPassportVoiceRecordContext(result string, loaded passportVoiceRecordContext) {
+	if s.Log == nil {
+		return
+	}
+	s.Log.Info("passport record context",
+		slog.String("result", result),
+		slog.Int("windowDays", passportVoiceRecordWindowDays),
+		slog.Int64("totalRecordCount", loaded.TotalRecordCount),
+		slog.Int64("recentRecordCount", loaded.RecentRecordCount),
+		slog.Bool("truncated", loaded.Truncated))
+}
