+    def case(self, name, action):
+        self.active_case = name
+        entry = {"name": name, "passed": False}
+        self.report["cases"].append(entry)
+        detail = action()
+        entry["passed"] = True
+        if detail is not None:
+            entry["evidence"] = detail
