new file mode 100644
index 0000000..efbe838
--- /dev/null
+++ b/internal/backend/asr_local_process_unix.go
@@ -0,0 +1,40 @@
+//go:build linux || darwin
+
+package backend
+
+import (
+	"errors"
+	"os"
+	"os/exec"
+	"syscall"
+	"time"
+)
+
+func configureLocalASRProcessGroup(cmd *exec.Cmd) {
+	cmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}
+	cmd.Cancel = func() error {
+		if cmd.Process == nil || cmd.ProcessState != nil {
+			return nil
+		}
+		err := syscall.Kill(-cmd.Process.Pid, syscall.SIGKILL)
+		if err == nil || errors.Is(err, syscall.ESRCH) || errors.Is(err, os.ErrProcessDone) {
+			return nil
+		}
+		return err
+	}
+	cmd.WaitDelay = 2 * time.Second
+}
+
+func stopLocalASRProcessGroup(pid int) error {
+	if err := syscall.Kill(-pid, 0); err != nil {
+		if errors.Is(err, syscall.ESRCH) {
+			return nil
+		}
+		return err
+	}
+	err := syscall.Kill(-pid, syscall.SIGKILL)
+	if errors.Is(err, syscall.ESRCH) {
+		return nil
+	}
+	return err
+}
diff --git a/internal/backend/asr_local_test.go b/internal/backend/asr_local_test.go
