+interface OpenAiResponsesStreamState {
+  deltaText: string;
+  deltaBytes: number;
+  deltaMode: "undecided" | "plain" | "structured";
+  pendingText: string;
+  completedText: string | null;
+  model?: string;
+  usage?: Record<string, unknown>;
+  completed: boolean;
