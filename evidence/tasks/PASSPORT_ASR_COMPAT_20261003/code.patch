+)
+
+type passportRecordIntegrationCase struct {
+	name, wireKind, kind, table string
+	build                       func(*passportConfirmationFixture, time.Time, string) (Object, Object)
+	seedFood                    bool
+}
+
+func TestPassportConfirmedRecordsIntegration(t *testing.T) {
+	h := newPassportConfirmationPG(t)
+	guardCtx, guardCancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer guardCancel()
+	for _, table := range []string{
+		"feeding_records", "sleep_records", "diaper_records", "food_records",
+		"supplement_records", "growth_measurements", "food_library_items",
+	} {
+		var exists bool
+		if err := h.controlDB.QueryRow(guardCtx, `SELECT to_regclass($1) IS NOT NULL`, "public."+table).Scan(&exists); err != nil {
+			t.Fatalf("check migrated test table %s: %v", table, err)
+		}
+		if !exists {
+			t.Fatalf("test database is missing public.%s; apply the tracked Prisma migrations", table)
+		}
+	}
+
+	cases := []passportRecordIntegrationCase{
+		{
+			name: "feeding", wireKind: "feeding", kind: "feeding", table: "feeding_records",
+			build: func(_ *passportConfirmationFixture, at time.Time, _ string) (Object, Object) {
+				return Object{"feedingType": "formula", "amountMl": "145.500", "occurredAt": at.Format(time.RFC3339Nano), "notes": "test feeding note"},
+					Object{"feeding_type": "formula", "amount_ml": passportExpectedNumber("145.500"), "occurred_at": at, "notes": "test feeding note", "source": "passport", "source_agent": "passport"}
+			},
+		},
+		{
+			name: "sleep", wireKind: "sleep", kind: "sleep", table: "sleep_records",
+			build: func(_ *passportConfirmationFixture, at time.Time, _ string) (Object, Object) {
+				started, ended := at.Add(-45*time.Minute), at
+				return Object{"sleepType": "nap", "startedAt": started.Format(time.RFC3339Nano), "endedAt": ended.Format(time.RFC3339Nano), "nightWakingCount": 1, "notes": "test sleep note"},
+					Object{"sleep_type": "nap", "started_at": started, "ended_at": ended, "night_waking_count": passportExpectedNumber("1"), "notes": "test sleep note", "source": "passport", "source_agent": "passport"}
+			},
+		},
+		{
+			name: "diaper", wireKind: "diaper", kind: "diaper", table: "diaper_records",
+			build: func(_ *passportConfirmationFixture, at time.Time, _ string) (Object, Object) {
+				return Object{"diaperType": "both", "occurredAt": at.Format(time.RFC3339Nano), "poopColor": "brown", "poopConsistency": "soft", "notes": "test diaper note"},
+					Object{"diaper_type": "both", "occurred_at": at, "poop_color": "brown", "poop_consistency": "soft", "notes": "test diaper note", "source": "passport", "source_agent": "passport"}
+			},
+		},
+		{
+			name: "food alias", wireKind: "foodLog", kind: "food", table: "food_records", seedFood: true,
+			build: func(_ *passportConfirmationFixture, at time.Time, foodID string) (Object, Object) {
+				return Object{"recordDate": at.Format("2006-01-02"), "mealType": "lunch", "occurredAt": at.Format(time.RFC3339Nano), "foodItemIds": []any{foodID}, "portionDescription": "test portion", "reaction": "like", "notes": "test food note"},
+					Object{"record_date": at.Format("2006-01-02"), "meal_type": "lunch", "occurred_at": at, "food_item_ids": []string{foodID}, "portion_description": "test portion", "reaction": "like", "notes": "test food note", "source": "passport", "source_agent": "passport"}
+			},
+		},
+		{
+			name: "supplement alias", wireKind: "supplementRecord", kind: "supplement", table: "supplement_records",
+			build: func(_ *passportConfirmationFixture, at time.Time, _ string) (Object, Object) {
+				return Object{"supplementName": "test_vitamin_d", "occurredAt": at.Format(time.RFC3339Nano), "amount": "1.25 mL", "dose": "1.25000", "unitName": "mL", "notes": "test supplement note"},
+					Object{"supplement_name": "test_vitamin_d", "occurred_at": at, "amount": "1.25 mL", "dose": passportExpectedNumber("1.25000"), "unit_name": "mL", "notes": "test supplement note", "product_id": nil, "source": "passport", "source_agent": "passport"}
+			},
+		},
+		{
+			name: "growth alias", wireKind: "growthMeasurement", kind: "growth", table: "growth_measurements",
+			build: func(_ *passportConfirmationFixture, at time.Time, _ string) (Object, Object) {
+				return Object{"measurementDate": at.Format("2006-01-02"), "weightKg": "6.25", "heightCm": "61.2", "headCircumferenceCm": "40.1", "notes": "test growth note"},
+					Object{"measurement_date": at.Format("2006-01-02"), "weight_kg": passportExpectedNumber("6.25"), "height_cm": passportExpectedNumber("61.2"), "head_circumference_cm": passportExpectedNumber("40.1"), "notes": "test growth note", "attachment_id": nil}
+			},
+		},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			fx := newPassportConfirmationFixture(t, h.controlDB)
+			ctx, cancel := context.WithTimeout(context.Background(), 15*time.Second)
+			defer cancel()
+
+			at := time.Now().UTC().Truncate(time.Millisecond)
+			foodID := ""
+			if tc.seedFood {
+				foodID = seedPassportTestFoodItem(t, ctx, h.controlDB, fx)
+			}
+			payload, expected := tc.build(fx, at, foodID)
+			// Deliberately supply client-owned scope/source hints. The trusted
+			// session scope and Passport source must be what reaches PostgreSQL.
+			payload["familyId"] = "test_forged_family"
+			payload["babyId"] = "test_forged_baby"
+			payload["id"] = "test_forged_record"
+			payload["source"] = "test_forged_source"
+			payload["sourceAgent"] = "test_forged_agent"
+			actionID, runID, planHash := newID(), newID(), "test_plan_"+newID()
+			action := nativeAIAction{ActionID: actionID, EntityType: tc.wireKind, Operation: "create", Summary: "Test Passport " + tc.kind + " record", Payload: payload}
+
+			firstID, err := h.server.executePassportCardConfirmation(ctx, fx.principal, runID, planHash, actionID, planHash, action, time.Now().Add(2*time.Minute))
+			if err != nil {
+				t.Fatalf("create %s Passport record: %v", tc.kind, err)
+			}
+			if firstID == "" {
+				t.Fatal("create returned an empty record id")
+			}
+			requirePassportPersistedRecord(t, ctx, h.controlDB, tc.table, firstID, fx, expected)
+			requirePassportTableRecordCount(t, ctx, h.controlDB, tc.table, fx, 1)
+
+			// Replay the same confirmation through the canonical entity name.
+			// Alias normalization and the normal receipt path must return the
+			// original row without creating another record.
+			replay := action
+			replay.EntityType = tc.kind
+			replayID, err := h.server.executePassportCardConfirmation(ctx, fx.principal, runID, planHash, actionID, planHash, replay, time.Now().Add(2*time.Minute))
+			if err != nil {
+				t.Fatalf("replay %s Passport confirmation: %v", tc.kind, err)
+			}
+			if replayID != firstID {
+				t.Fatalf("replay returned record id %q, want original %q", replayID, firstID)
+			}
+			requirePassportTableRecordCount(t, ctx, h.controlDB, tc.table, fx, 1)
+		})
+	}
+
+	t.Run("missing required field writes no record", func(t *testing.T) {
+		fx := newPassportConfirmationFixture(t, h.controlDB)
+		ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+		defer cancel()
+		id, runID, planHash := newID(), newID(), "test_plan_"+newID()
+		action := nativeAIAction{ActionID: id, EntityType: "feeding", Operation: "create", Summary: "Test invalid feeding", Payload: Object{"amountMl": "20"}}
+		recordID, err := h.server.executePassportCardConfirmation(ctx, fx.principal, runID, planHash, id, planHash, action, time.Now().Add(2*time.Minute))
+		if err == nil || recordID != "" {
+			t.Fatalf("invalid create returned record id %q and error %v; want an error and no record id", recordID, err)
+		}
+		requirePassportTableRecordCount(t, ctx, h.controlDB, "feeding_records", fx, 0)
+	})
+
+	t.Run("non-create operation writes no record", func(t *testing.T) {
+		fx := newPassportConfirmationFixture(t, h.controlDB)
+		ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+		defer cancel()
+		id, runID, planHash := newID(), newID(), "test_plan_"+newID()
+		action := nativeAIAction{ActionID: id, EntityType: "feeding", Operation: "update", Summary: "Test invalid feeding update", Payload: Object{"feedingType": "formula", "occurredAt": time.Now().UTC().Format(time.RFC3339Nano)}}
+		recordID, err := h.server.executePassportCardConfirmation(ctx, fx.principal, runID, planHash, id, planHash, action, time.Now().Add(2*time.Minute))
+		if err == nil || recordID != "" {
+			t.Fatalf("non-create operation returned record id %q and error %v; want an error and no record id", recordID, err)
+		}
+		requirePassportTableRecordCount(t, ctx, h.controlDB, "feeding_records", fx, 0)
+	})
+}
+
+type passportExpectedNumber string
+
+func seedPassportTestFoodItem(t *testing.T, ctx context.Context, db *pgxpool.Pool, fx *passportConfirmationFixture) string {
+	t.Helper()
+	foodID := "test_food_" + strings.ReplaceAll(newID(), "-", "")
+	// The item is scoped to this independently generated test family. Never
+	// select an existing catalog row as a fixture.
+	_, err := db.Exec(ctx, `INSERT INTO food_library_items(
+		id,name,category,allergen_risk,recommended_age_months,is_custom,family_id,created_at,updated_at
+	) VALUES($1,'Test Passport Pear','fruit','low',6,true,$2,clock_timestamp(),clock_timestamp())`, foodID, fx.familyID)
+	if err != nil {
+		t.Fatalf("seed test-owned food library item: %v", err)
+	}
+	return foodID
+}
+
+func requirePassportPersistedRecord(t *testing.T, ctx context.Context, db *pgxpool.Pool, table, recordID string, fx *passportConfirmationFixture, expected Object) {
+	t.Helper()
+	query := "SELECT to_jsonb(r) FROM public." + pgx.Identifier{table}.Sanitize() + " r WHERE id=$1 AND family_id=$2 AND baby_id=$3"
+	row, err := one(ctx, db, query, recordID, fx.familyID, fx.babyID)
+	if err != nil {
+		t.Fatalf("read persisted test %s record: %v", table, err)
+	}
+	common := Object{"id": recordID, "family_id": fx.familyID, "baby_id": fx.babyID, "version": passportExpectedNumber("1"), "deleted_at": nil}
+	if table != "growth_measurements" {
+		common["source"] = "passport"
+		if table == "feeding_records" || table == "sleep_records" || table == "diaper_records" {
+			common["source_agent"] = "passport"
+		} else {
+			// Food and supplement create contracts have no sourceAgent request
+			// property; normalizeBody removes it before the insert callback.
+			common["source_agent"] = nil
+		}
+	}
+	if table == "feeding_records" || table == "sleep_records" || table == "diaper_records" || table == "supplement_records" {
+		common["recorded_by_user_id"] = fx.userID
+	}
+	for column, value := range common {
+		expected[column] = value
+	}
+	for column, want := range expected {
+		got, ok := row[column]
+		if !ok {
+			t.Errorf("persisted %s record lacks column %s", table, column)
+			continue
+		}
+		if err := comparePassportPersistedValue(column, got, want); err != nil {
+			t.Errorf("persisted %s.%s = %#v, want %#v: %v", table, column, got, want, err)
+		}
+	}
+}
+
+func comparePassportPersistedValue(column string, got, want any) error {
+	switch expected := want.(type) {
+	case passportExpectedNumber:
+		wantNumber, ok := new(big.Rat).SetString(string(expected))
+		if !ok {
+			return fmt.Errorf("invalid expected number %q", expected)
+		}
+		gotNumber, ok := new(big.Rat).SetString(text(got))
+		if !ok || gotNumber.Cmp(wantNumber) != 0 {
+			return fmt.Errorf("numeric value differs")
+		}
+	case time.Time:
+		value, ok := got.(string)
+		if !ok {
+			return fmt.Errorf("want timestamp string, got %T", got)
+		}
+		actual, err := time.Parse(time.RFC3339Nano, value)
+		if err != nil || !actual.Equal(expected) {
+			return fmt.Errorf("timestamp differs (actual %q, parse error %v)", value, err)
+		}
+	case []string:
+		actual, ok := got.([]any)
+		if !ok {
+			return fmt.Errorf("want JSON array, got %T", got)
+		}
+		values := make([]string, len(actual))
+		for i, item := range actual {
+			value, ok := item.(string)
+			if !ok {
+				return fmt.Errorf("array item %d has type %T", i, item)
+			}
+			values[i] = value
+		}
+		if !reflect.DeepEqual(values, expected) {
+			return fmt.Errorf("array value differs")
+		}
+	case nil:
+		if got != nil {
+			return fmt.Errorf("want null")
+		}
+	case string:
+		if text(got) != expected {
+			return fmt.Errorf("string value differs (got %q)", text(got))
+		}
+	default:
+		if !reflect.DeepEqual(got, expected) {
+			return fmt.Errorf("value differs")
+		}
+	}
+	return nil
+}
+
+func requirePassportTableRecordCount(t *testing.T, ctx context.Context, db *pgxpool.Pool, table string, fx *passportConfirmationFixture, want int) {
+	t.Helper()
+	query := "SELECT count(*) FROM public." + pgx.Identifier{table}.Sanitize() + " WHERE family_id=$1 AND baby_id=$2"
+	var count int
+	if err := db.QueryRow(ctx, query, fx.familyID, fx.babyID).Scan(&count); err != nil {
+		t.Fatalf("count test %s records: %v", table, err)
+	}
+	if count != want {
+		t.Fatalf("%s record count = %d, want %d", table, count, want)
+	}
+}
diff --git a/internal/backend/passport_silence.go b/internal/backend/passport_silence.go
new file mode 100644
index 0000000..c2b307b
--- /dev/null
+++ b/internal/backend/passport_silence.go
@@ -0,0 +1,31 @@
+package backend
+
+import (
+	"bytes"
+	"encoding/binary"
+)
+
+// Reject exact digital silence in the canonical device WAV. This does not
+// estimate speech or apply an uncalibrated amplitude threshold to the mic.
+func passportWavIsDigitalSilence(wav []byte) bool {
+	if len(wav) < 46 || (len(wav)-44)%2 != 0 ||
+		!bytes.Equal(wav[:4], []byte("RIFF")) || !bytes.Equal(wav[8:16], []byte("WAVEfmt ")) ||
+		!bytes.Equal(wav[36:40], []byte("data")) ||
+		binary.LittleEndian.Uint32(wav[4:8]) != uint32(len(wav)-8) ||
+		binary.LittleEndian.Uint32(wav[16:20]) != 16 ||
+		binary.LittleEndian.Uint16(wav[20:22]) != 1 ||
+		binary.LittleEndian.Uint16(wav[22:24]) != 1 ||
+		binary.LittleEndian.Uint32(wav[24:28]) != 16000 ||
+		binary.LittleEndian.Uint32(wav[28:32]) != 32000 ||
+		binary.LittleEndian.Uint16(wav[32:34]) != 2 ||
+		binary.LittleEndian.Uint16(wav[34:36]) != 16 ||
+		binary.LittleEndian.Uint32(wav[40:44]) != uint32(len(wav)-44) {
+		return false
+	}
+	for _, sampleByte := range wav[44:] {
+		if sampleByte != 0 {
+			return false
+		}
+	}
+	return true
+}
diff --git a/internal/backend/passport_silence_test.go b/internal/backend/passport_silence_test.go
new file mode 100644
index 0000000..cc79be9
--- /dev/null
+++ b/internal/backend/passport_silence_test.go
@@ -0,0 +1,59 @@
+package backend
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func TestPassportDigitalSilenceNeverReachesRecognizer(t *testing.T) {
+	var calls atomic.Int32
+	provider := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		calls.Add(1)
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"text":"test recognition"}`))
+	}))
+	defer provider.Close()
+	config := nativeProviderConfig{Mode: "openai-compatible", Endpoint: provider.URL + "/chat/completions", APIKey: "test_key", Timeout: time.Second}
+	wav := buildWavFile(make([]byte, 32000), 16000, 1, 16)
+	transcript, err := (&Server{}).transcribePassportWav(context.Background(), config, wav)
+	var failure *nativeProviderError
+	if transcript != "" || !errors.As(err, &failure) || failure.Code != "ASR_PROVIDER_NO_SPEECH" || calls.Load() != 0 {
+		t.Fatalf("digital silence reached recognition: transcript=%q err=%v calls=%d", transcript, err, calls.Load())
+	}
+	// A nonzero sample passes only the exact-zero guard; this is no claim that
+	// a one-bit signal is audible speech or that model recognition is accurate.
+	wav[44] = 1
+	transcript, err = (&Server{}).transcribePassportWav(context.Background(), config, wav)
+	if err != nil || transcript != "test recognition" || calls.Load() != 1 {
+		t.Fatalf("nonzero input was filtered: %q %v calls=%d", transcript, err, calls.Load())
+	}
+}
+
+func TestPassportDigitalSilenceCannotPublishAConversationOrProposal(t *testing.T) {
+	clearSpeechTestEnvironment(t)
+	t.Setenv("GROWDESK_AI_PROVIDER", "fixture")
+	t.Setenv("GROWDESK_ASR_FIXTURE_TEXT", "must not be recognized")
+	t.Setenv("GROWDESK_AI_FIXTURE_RESPONSE", `{"text":"must not be answered","actions":[]}`)
+	var events []Object
+	var pending passportPending[pendingCardProposal]
+	// An accidentally continued pipeline would hit the nil DB for this session.
+	(&Server{}).processVoiceTurn(context.Background(), &PassportPrincipal{BabyID: "test_baby"}, "test_session", "test baby", "test_turn", buildWavFile(make([]byte, 32000), 16000, 1, 16),
+		func(v any) error { events = append(events, v.(Object)); return nil },
+		func([]byte) error { t.Fatal("silence emitted audio"); return nil }, &passportPlaybackControl{}, nil, &pending)
+	if len(events) != 1 || events[0]["type"] != "error" || events[0]["code"] != "ASR_PROVIDER_NO_SPEECH" || events[0]["turnId"] != "test_turn" || pending.load() != nil {
+		t.Fatalf("silence continued into the conversation: %#v", events)
+	}
+}
+
+func TestPassportDigitalSilenceOnlyRecognizesTheCanonicalFormat(t *testing.T) {
+	for _, wav := range [][]byte{nil, []byte("test input"), buildWavFile(make([]byte, 32000), 24000, 1, 16), buildWavFile([]byte{0}, 16000, 1, 16)} {
+		if passportWavIsDigitalSilence(wav) {
+			t.Fatal("noncanonical input classified as exact device silence")
+		}
+	}
+}
diff --git a/internal/backend/passport_tts.go b/internal/backend/passport_tts.go
new file mode 100644
index 0000000..2628138
--- /dev/null
+++ b/internal/backend/passport_tts.go
@@ -0,0 +1,430 @@
+package backend
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"io"
+	"mime"
+	"net"
+	"net/http"
+	"net/url"
+	"os"
+	"strconv"
+	"strings"
+	"time"
+)
+
+const (
+	maxPassportTTSTextBytes   = 256 * 1024
+	maxPassportTTSOutputBytes = 8 * 1024 * 1024
+	passportTTSChunkBytes     = 1920 // 40 ms of 24 kHz, 16-bit, mono PCM.
+)
+
+type passportTTSConfig struct {
+	Mode     string
+	Endpoint string
+	APIKey   string
+	Model    string
+	Voice    string
+	Timeout  time.Duration
+	Local    localPassportTTSConfig
+}
+
+func passportTTSFailure(code, message string, retryable bool) error {
+	return providerFailure(code, message, retryable)
+}
+
+// passportTTSConfiguration keeps speech output independently configurable.
+// Reusing the common provider requires the explicit "shared" selector; a
+// dedicated endpoint may reuse its key only when its canonical audio URL is
+// identical to the compatible common provider's canonical audio URL.
+func passportTTSConfiguration(common nativeProviderConfig) (passportTTSConfig, error) {
+	c := passportTTSConfig{
+		Timeout: common.Timeout,
+		Model:   strings.TrimSpace(os.Getenv("GROWDESK_TTS_MODEL")),
+		Voice:   strings.TrimSpace(os.Getenv("GROWDESK_TTS_VOICE")),
+	}
+	if c.Timeout <= 0 {
+		c.Timeout = 10 * time.Second
+	}
+	if raw := strings.TrimSpace(os.Getenv("GROWDESK_TTS_TIMEOUT_MS")); raw != "" {
+		millis, err := strconv.ParseInt(raw, 10, 64)
+		if err != nil || millis < 100 || millis > 180000 {
+			return c, passportTTSFailure("TTS_PROVIDER_CONFIG_INVALID", "TTS timeout must be between 100 and 180000 milliseconds", false)
+		}
+		c.Timeout = time.Duration(millis) * time.Millisecond
+	}
+
+	provider := strings.ToLower(strings.TrimSpace(os.Getenv("GROWDESK_TTS_PROVIDER")))
+	baseURL := strings.TrimSpace(os.Getenv("GROWDESK_TTS_BASE_URL"))
+	apiKey := strings.TrimSpace(os.Getenv("GROWDESK_TTS_API_KEY"))
+	if provider == "" {
+		if common.Mode == "fixture" && baseURL == "" && apiKey == "" {
+			provider = "fixture"
+		} else if baseURL != "" || apiKey != "" {
+			provider = "openai-compatible"
+		} else {
+			return c, passportTTSFailure("TTS_PROVIDER_NOT_CONFIGURED", "Set GROWDESK_TTS_PROVIDER=shared or configure a dedicated TTS provider", false)
+		}
+	}
+	if provider == "openai" || provider == "compat" {
+		provider = "openai-compatible"
+	}
+	if provider == "local" {
+		provider = "local-espeak"
+	}
+	if provider == "local-espeak" {
+		if baseURL != "" || apiKey != "" || c.Model != "" || (c.Voice != "" && !strings.EqualFold(c.Voice, "cmn")) {
+			return c, passportTTSFailure("TTS_PROVIDER_CONFIG_INVALID", "Local eSpeak TTS accepts only the cmn voice and no remote endpoint or model", false)
+		}
+		local, err := passportTTSLocalConfiguration(c.Timeout)
+		if err != nil {
+			return c, err
+		}
+		c.Mode = "local-espeak"
+		c.Voice = "cmn"
+		c.Local = local
+		return c, nil
+	}
+	if provider == "local-sherpa" {
+		if baseURL != "" || apiKey != "" || c.Model != "" || (c.Voice != "" && !strings.EqualFold(c.Voice, "zh")) {
+			return c, passportTTSFailure("TTS_PROVIDER_CONFIG_INVALID", "Local Sherpa TTS accepts only the zh voice and no remote endpoint, credentials, or model", false)
+		}
+		local, err := passportTTSLocalSherpaConfiguration(c.Timeout)
+		if err != nil {
+			return c, err
+		}
+		c.Mode = "local-sherpa"
+		c.Voice = "zh"
+		c.Local = local
+		return c, nil
+	}
+	if provider == "fixture" {
+		if common.Mode != "fixture" {
+			return c, passportTTSFailure("TTS_PROVIDER_NOT_CONFIGURED", "TTS fixtures require the explicit AI fixture provider", false)
+		}
+		c.Mode = "fixture"
+		return c, nil
+	}
+	if provider == "shared" {
+		if common.Mode != "openai-compatible" || common.Endpoint == "" || common.APIKey == "" || baseURL != "" || apiKey != "" {
+			return c, passportTTSFailure("TTS_PROVIDER_NOT_CONFIGURED", "Shared TTS requires the configured compatible common provider and no separate endpoint credentials", false)
+		}
+		baseURL = common.Endpoint
+		apiKey = common.APIKey
+		provider = "openai-compatible"
+	}
+	if provider != "openai-compatible" {
+		return c, passportTTSFailure("TTS_PROVIDER_CONFIG_INVALID", "Unsupported TTS provider", false)
+	}
+
+	if baseURL == "" {
+		return c, passportTTSFailure("TTS_PROVIDER_NOT_CONFIGURED", "Configure GROWDESK_TTS_BASE_URL and GROWDESK_TTS_API_KEY", false)
+	}
+	endpoint, err := passportTTSEndpoint(baseURL)
+	if err != nil {
+		return c, err
+	}
+	if apiKey == "" && common.Mode == "openai-compatible" && common.Endpoint != "" && common.APIKey != "" {
+		commonEndpoint, commonErr := passportTTSEndpoint(common.Endpoint)
+		if commonErr == nil && endpoint == commonEndpoint {
+			apiKey = common.APIKey
+		}
+	}
+	if apiKey == "" {
+		return c, passportTTSFailure("TTS_PROVIDER_NOT_CONFIGURED", "Configure a TTS API key for this endpoint", false)
+	}
+	if len(apiKey) > 4096 || strings.ContainsAny(apiKey, "\r\n") {
+		return c, passportTTSFailure("TTS_PROVIDER_CONFIG_INVALID", "TTS API key is invalid", false)
+	}
+	if len(c.Model) > 128 || len(c.Voice) > 64 || strings.ContainsAny(c.Model, "\r\n") || strings.ContainsAny(c.Voice, "\r\n") {
+		return c, passportTTSFailure("TTS_PROVIDER_CONFIG_INVALID", "TTS model or voice is invalid", false)
+	}
+	if c.Model == "" {
+		c.Model = "tts-1"
+	}
+	if c.Voice == "" {
+		c.Voice = "alloy"
+	}
+	c.Mode = "openai-compatible"
+	c.Endpoint = endpoint
+	c.APIKey = apiKey
+	return c, nil
+}
+
+func passportTTSEndpoint(raw string) (string, error) {
+	u, err := url.Parse(strings.TrimSpace(raw))
+	if err != nil {
+		return "", passportTTSFailure("TTS_PROVIDER_CONFIG_INVALID", "TTS base URL is invalid", false)
+	}
+	u.Scheme = strings.ToLower(u.Scheme)
+	if u.Hostname() == "" || (u.Scheme != "https" && u.Scheme != "http") || u.User != nil || u.RawQuery != "" || u.Fragment != "" || u.Opaque != "" {
+		return "", passportTTSFailure("TTS_PROVIDER_CONFIG_INVALID", "TTS base URL is invalid", false)
+	}
+	hostname, port := strings.ToLower(u.Hostname()), u.Port()
+	if (u.Scheme == "https" && port == "443") || (u.Scheme == "http" && port == "80") {
+		port = ""
+	}
+	if port != "" {
+		u.Host = net.JoinHostPort(hostname, port)
+	} else if strings.Contains(hostname, ":") {
+		u.Host = "[" + hostname + "]"
+	} else {
+		u.Host = hostname
+	}
+	path := strings.TrimRight(u.Path, "/")
+	if strings.HasSuffix(path, "/audio/speech") {
+		u.Path = path
+		u.RawPath = ""
+		return u.String(), nil
+	}
+	path = strings.TrimSuffix(path, "/chat/completions")
+	u.Path = strings.TrimRight(path, "/") + "/audio/speech"
+	u.RawPath = ""
+	return u.String(), nil
+}
+
+func passportTTSErrorEvent(turnID string, err error) Object {
+	code, message := "TTS_PROVIDER_FAILED", "Speech generation failed"
+	switch {
+	case errors.Is(err, context.Canceled):
+		code, message = "TTS_PROVIDER_CANCELLED", "Speech generation was cancelled"
+	case errors.Is(err, context.DeadlineExceeded):
+		code, message = "TTS_PROVIDER_TIMEOUT", "Speech provider request timed out"
+	default:
+		var providerErr *nativeProviderError
+		if errors.As(err, &providerErr) && strings.HasPrefix(providerErr.Code, "TTS_PROVIDER_") {
+			code, message = providerErr.Code, providerErr.Message
+		}
+	}
+	return Object{"v": 1, "type": "error", "turnId": turnID, "code": code, "message": message}
+}
+
+// synthesizePassportTTS buffers only within a strict byte budget so the
+// caller can reject an empty, malformed, or truncated PCM stream before
+// telling the client that playback has started.
+func synthesizePassportTTS(ctx context.Context, c passportTTSConfig, text string) ([]byte, error) {
+	if strings.TrimSpace(text) == "" || len(text) > maxPassportTTSTextBytes {
+		return nil, passportTTSFailure("TTS_PROVIDER_INVALID_INPUT", "Text to speak is empty or too large", false)
+	}
+	if c.Mode == "local-espeak" || c.Mode == "local-sherpa" {
+		return synthesizeLocalPassportTTS(ctx, c.Local, text)
+	}
+	if c.Mode == "fixture" {
+		select {
+		case <-ctx.Done():
+			return nil, ctx.Err()
+		default:
+		}
+		return make([]byte, 24000*2/10), nil // Explicit fixture: 100 ms of silence.
+	}
+	if c.Mode != "openai-compatible" || c.Endpoint == "" || c.APIKey == "" {
+		return nil, passportTTSFailure("TTS_PROVIDER_NOT_CONFIGURED", "Configure a compatible TTS provider", false)
+	}
+	if c.Timeout <= 0 {
+		c.Timeout = 10 * time.Second
+	}
+	requestContext, cancel := context.WithTimeout(ctx, c.Timeout)
+	defer cancel()
+	body, err := jsonBytes(Object{
+		"model":           c.Model,
+		"input":           text,
+		"voice":           c.Voice,
+		"response_format": "pcm",
+	})
+	if err != nil {
+		return nil, passportTTSFailure("TTS_PROVIDER_REQUEST_FAILED", "Speech request could not be prepared", false)
+	}
+	request, err := http.NewRequestWithContext(requestContext, http.MethodPost, c.Endpoint, bytes.NewReader(body))
+	if err != nil {
+		return nil, passportTTSFailure("TTS_PROVIDER_CONFIG_INVALID", "TTS endpoint is invalid", false)
+	}
+	request.Header.Set("Content-Type", "application/json")
+	request.Header.Set("Accept", "audio/pcm, application/octet-stream")
+	request.Header.Set("Authorization", "Bearer "+c.APIKey)
+	client := providerHTTPClient(c.Timeout)
+	return synthesizePassportTTSWithClient(requestContext, c, request, client)
+}
+
+func synthesizePassportTTSWithClient(ctx context.Context, c passportTTSConfig, request *http.Request, client *http.Client) ([]byte, error) {
+	defer client.CloseIdleConnections()
+	response, err := client.Do(request)
+	if err != nil {
+		return nil, passportTTSTransportError(ctx, err)
+	}
+	defer response.Body.Close()
+	if response.StatusCode < http.StatusOK || response.StatusCode >= http.StatusMultipleChoices {
+		code := "TTS_PROVIDER_HTTP_ERROR"
+		message := "Speech provider returned HTTP " + strconv.Itoa(response.StatusCode)
+		if response.StatusCode == http.StatusUnauthorized || response.StatusCode == http.StatusForbidden {
+			code = "TTS_PROVIDER_AUTH_FAILED"
+			message = "Speech provider authentication failed (HTTP " + strconv.Itoa(response.StatusCode) + ")"
+		}
+		retryable := response.StatusCode == http.StatusRequestTimeout || response.StatusCode == http.StatusConflict || response.StatusCode == http.StatusTooManyRequests || response.StatusCode >= 500
+		return nil, passportTTSFailure(code, message, retryable)
+	}
+	if !passportTTSContentTypeAllowed(response.Header.Get("Content-Type")) {
+		return nil, passportTTSFailure("TTS_PROVIDER_INVALID_RESPONSE", "Speech provider returned an unsupported audio format", false)
+	}
+	pcm, err := io.ReadAll(io.LimitReader(response.Body, maxPassportTTSOutputBytes+1))
+	if err != nil {
+		if ctx.Err() != nil {
+			return nil, passportTTSTransportError(ctx, err)
+		}
+		return nil, passportTTSFailure("TTS_PROVIDER_RESPONSE_READ_FAILED", "Speech provider response could not be read", true)
+	}
+	if len(pcm) == 0 || len(pcm) > maxPassportTTSOutputBytes || len(pcm)%2 != 0 || bytes.HasPrefix(pcm, []byte("RIFF")) {
+		return nil, passportTTSFailure("TTS_PROVIDER_INVALID_RESPONSE", "Speech provider returned empty or invalid PCM audio", false)
+	}
+	// Raw PCM has no self-describing header, so the size, alignment and media
+	// metadata checks cannot prove the bytes contain meaningful audio samples.
+	return pcm, nil
+}
+
+func passportTTSContentTypeAllowed(raw string) bool {
+	if strings.TrimSpace(raw) == "" {
+		return false
+	}
+	mediaType, params, err := mime.ParseMediaType(raw)
+	if err != nil {
+		return false
+	}
+	switch strings.ToLower(mediaType) {
+	case "audio/pcm", "audio/raw", "audio/x-pcm", "application/octet-stream", "application/binary":
+	default:
+		return false
+	}
+	for key, value := range params {
+		value = strings.ToLower(strings.TrimSpace(value))
+		switch strings.ToLower(key) {
+		case "rate", "samplerate", "sample-rate", "sampling-rate":
+			if value != "24000" {
+				return false
+			}
+		case "channels", "channel":
+			if value != "1" {
+				return false
+			}
+		case "bits", "bit-depth", "bits-per-sample":
+			if value != "16" {
+				return false
+			}
+		case "endianness", "endian", "byte-order":
+			if value != "little" && value != "little-endian" && value != "le" {
+				return false
+			}
+		case "encoding", "format":
+			if value != "s16le" && value != "pcm_s16le" && value != "signed-16le" {
+				return false
+			}
+		case "layout", "channel-layout":
+			if value != "mono" {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+func passportTTSTransportError(ctx context.Context, err error) error {
+	if errors.Is(ctx.Err(), context.Canceled) || errors.Is(err, context.Canceled) {
+		return context.Canceled
+	}
+	var networkError interface{ Timeout() bool }
+	if errors.Is(ctx.Err(), context.DeadlineExceeded) || errors.Is(err, context.DeadlineExceeded) || (errors.As(err, &networkError) && networkError.Timeout()) {
+		return passportTTSFailure("TTS_PROVIDER_TIMEOUT", "Speech provider request timed out", true)
+	}
+	return passportTTSFailure("TTS_PROVIDER_NETWORK_ERROR", "Speech provider connection failed", true)
+}
+
+// streamPassportTTS validates provider output before emitting tts.start, then
+// preserves the existing 24 kHz mono PCM event and binary-chunk contract.
+func (s *Server) streamPassportTTS(ctx context.Context, common nativeProviderConfig, turnID, textToSpeak string, sendJSON func(any) error, sendBinary func([]byte) error) {
+	config, err := passportTTSConfiguration(common)
+	if err != nil {
+		_ = sendJSON(passportTTSErrorEvent(turnID, err))
+		return
+	}
+	pcm, err := synthesizePassportTTS(ctx, config, textToSpeak)
+	if err != nil {
+		if errors.Is(ctx.Err(), context.Canceled) || errors.Is(err, context.Canceled) {
+			return
+		}
+		_ = sendJSON(passportTTSErrorEvent(turnID, err))
+		return
+	}
+	select {
+	case <-ctx.Done():
+		if !errors.Is(ctx.Err(), context.Canceled) {
+			_ = sendJSON(passportTTSErrorEvent(turnID, ctx.Err()))
+		}
+		return
+	default:
+	}
+	if err := sendJSON(Object{
+		"v":      1,
+		"type":   "tts.start",
+		"turnId": turnID,
+		"audioFormat": Object{
+			"codec":      "pcm_s16le",
+			"sampleRate": 24000,
+			"channels":   1,
+		},
+	}); err != nil {
+		return
+	}
+	for offset := 0; offset < len(pcm); {
+		select {
+		case <-ctx.Done():
+			if !errors.Is(ctx.Err(), context.Canceled) {
+				_ = sendJSON(passportTTSErrorEvent(turnID, ctx.Err()))
+			}
+			return
+		default:
+		}
+		end := offset + passportTTSChunkBytes
+		if end > len(pcm) {
+			end = len(pcm)
+		}
+		chunkSize := end - offset
+		chunkStarted := time.Now()
+		if err := sendBinary(pcm[offset:end]); err != nil {
+			_ = sendJSON(passportTTSErrorEventWithCode(turnID, "TTS_PROVIDER_STREAM_FAILED", "Speech audio could not be sent"))
+			return
+		}
+		offset = end
+		if delay := passportTTSPacingDelay(chunkSize, time.Since(chunkStarted)); delay > 0 {
+			timer := time.NewTimer(delay)
+			select {
+			case <-ctx.Done():
+				timer.Stop()
+				if !errors.Is(ctx.Err(), context.Canceled) {
+					_ = sendJSON(passportTTSErrorEvent(turnID, ctx.Err()))
+				}
+				return
+			case <-timer.C:
+			}
+		}
+	}
+	_ = sendJSON(Object{"v": 1, "type": "tts.end", "turnId": turnID})
+}
+
+func passportTTSChunkDuration(byteCount int) time.Duration {
+	if byteCount <= 0 || byteCount%2 != 0 {
+		return 0
+	}
+	return time.Duration(byteCount/2) * time.Second / 24000
+}
+
+func passportTTSPacingDelay(byteCount int, writeDuration time.Duration) time.Duration {
+	remaining := passportTTSChunkDuration(byteCount) - writeDuration
+	if remaining < 0 {
+		return 0
+	}
+	return remaining
+}
+
+func passportTTSErrorEventWithCode(turnID, code, message string) Object {
+	return Object{"v": 1, "type": "error", "turnId": turnID, "code": code, "message": message}
+}
diff --git a/internal/backend/passport_tts_local.go b/internal/backend/passport_tts_local.go
new file mode 100644
index 0000000..eee0991
--- /dev/null
+++ b/internal/backend/passport_tts_local.go
@@ -0,0 +1,257 @@
+package backend
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"io"
+	"os"
+	"strings"
+	"time"
+	"unicode/utf8"
+)
+
+const (
+	maxPassportTTSWaveBytes                int64 = 12 * 1024 * 1024
+	maxPassportTTSStderr                   int64 = 16 * 1024
+	maxPassportTTSLocalCPUSec                    = 110
+	maxPassportTTSLocalTimeout                   = 110 * time.Second
+	maxLocalSherpaTTSTextBytes                   = 8 * 1024
+	localPassportTTSSherpaPythonPath             = "/srv/growdesk-tts/venv/bin/python"
+	localPassportTTSSherpaPyVenvConfigPath       = "/srv/growdesk-tts/venv/pyvenv.cfg"
+	localPassportTTSSherpaSitePackagesPath       = "/srv/growdesk-tts/venv/lib/python3.12/site-packages"
+	localPassportTTSSherpaScriptPath             = "/srv/growdesk-tts/synthesize.py"
+)
+
+var localPassportTTSSlot = make(chan struct{}, 1)
+
+func localPassportTTSChildEnvironment(tempDir string) []string {
+	return []string{
+		"PATH=/usr/bin:/bin",
+		"HOME=" + tempDir,
+		"TMPDIR=" + tempDir,
+		"LANG=C.UTF-8",
+		"LC_ALL=C.UTF-8",
+	}
+}
+
+type localPassportTTSConfig struct {
+	engine                   string
+	espeakPath               string
+	sherpaPythonPath         string
+	sherpaPythonResolvedPath string
+	sherpaScriptPath         string
+	ffmpegPath               string
+	limiterPath              string
+	timeout                  time.Duration
+	tempParent               string
+}
+
+func passportTTSLocalConfiguration(timeout time.Duration) (localPassportTTSConfig, error) {
+	if timeout <= 0 {
+		timeout = 10 * time.Second
+	}
+	if timeout > maxPassportTTSLocalTimeout {
+		timeout = maxPassportTTSLocalTimeout
+	}
+	config, err := platformPassportTTSLocalConfiguration(timeout)
+	if err != nil {
+		return localPassportTTSConfig{}, err
+	}
+	config.engine = "local-espeak"
+	return config, nil
+}
+
+func passportTTSLocalSherpaConfiguration(timeout time.Duration) (localPassportTTSConfig, error) {
+	if timeout <= 0 {
+		timeout = 10 * time.Second
+	}
+	if timeout > maxPassportTTSLocalTimeout {
+		timeout = maxPassportTTSLocalTimeout
+	}
+	config, err := platformPassportTTSLocalSherpaConfiguration(timeout)
+	if err != nil {
+		return localPassportTTSConfig{}, err
+	}
+	config.engine = "local-sherpa"
+	return config, nil
+}
+
+func validateLocalPassportTTSConfig(config localPassportTTSConfig) error {
+	if config.ffmpegPath == "" || config.limiterPath == "" || config.timeout <= 0 || config.timeout > maxPassportTTSLocalTimeout {
+		return passportTTSFailure("TTS_PROVIDER_CONFIG_INVALID", "Local speech synthesis configuration is invalid", false)
+	}
+	switch config.engine {
+	case "local-espeak":
+		if config.espeakPath == "" || config.sherpaPythonPath != "" || config.sherpaPythonResolvedPath != "" || config.sherpaScriptPath != "" {
+			return passportTTSFailure("TTS_PROVIDER_CONFIG_INVALID", "Local eSpeak speech synthesis configuration is invalid", false)
+		}
+	case "local-sherpa":
+		if config.espeakPath != "" || config.sherpaPythonPath != localPassportTTSSherpaPythonPath || config.sherpaPythonResolvedPath == "" || config.sherpaScriptPath != localPassportTTSSherpaScriptPath {
+			return passportTTSFailure("TTS_PROVIDER_CONFIG_INVALID", "Local Sherpa speech synthesis configuration is invalid", false)
+		}
+	default:
+		return passportTTSFailure("TTS_PROVIDER_CONFIG_INVALID", "Local speech synthesis engine is unsupported", false)
+	}
+	return nil
+}
+
+func synthesizeLocalPassportTTS(ctx context.Context, config localPassportTTSConfig, text string) (pcm []byte, retErr error) {
+	maxTextBytes := maxPassportTTSTextBytes
+	if config.engine == "local-sherpa" {
+		maxTextBytes = maxLocalSherpaTTSTextBytes
+	}
+	if ctx == nil || strings.TrimSpace(text) == "" || len(text) > maxTextBytes || !utf8.ValidString(text) || strings.ContainsRune(text, '\x00') {
+		return nil, passportTTSFailure("TTS_PROVIDER_INVALID_INPUT", "Text to speak is empty, invalid, or too large", false)
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	if err := validateLocalPassportTTSConfig(config); err != nil {
+		return nil, err
+	}
+	select {
+	case localPassportTTSSlot <- struct{}{}:
+		defer func() { <-localPassportTTSSlot }()
+	default:
+		return nil, passportTTSFailure("TTS_PROVIDER_BUSY", "Local speech synthesis is busy", true)
+	}
+
+	tempDir, err := os.MkdirTemp(config.tempParent, "growdesk-tts-")
+	if err != nil {
+		return nil, passportTTSFailure("TTS_PROVIDER_TEMP_IO_FAILED", "Local speech synthesis could not create private temporary storage", true)
+	}
+	defer func() {
+		if cleanupErr := os.RemoveAll(tempDir); cleanupErr != nil {
+			pcm = nil
+			retErr = passportTTSFailure("TTS_PROVIDER_TEMP_IO_FAILED", "Local speech synthesis temporary files could not be removed", false)
+		}
+	}()
+	if err = os.Chmod(tempDir, 0700); err != nil {
+		return nil, passportTTSFailure("TTS_PROVIDER_TEMP_IO_FAILED", "Local speech synthesis could not protect temporary storage", false)
+	}
+
+	requestCtx, cancel := context.WithTimeout(ctx, config.timeout)
+	defer cancel()
+	if err := requestCtx.Err(); err != nil {
+		return nil, localPassportTTSCtxError(ctx, requestCtx, err)
+	}
+
+	waveFile, err := os.CreateTemp(tempDir, "speech-*.wav")
+	if err != nil {
+		return nil, passportTTSFailure("TTS_PROVIDER_TEMP_IO_FAILED", "Local speech synthesis could not create its private wave file", true)
+	}
+	if err = waveFile.Chmod(0600); err != nil {
+		_ = waveFile.Close()
+		return nil, passportTTSFailure("TTS_PROVIDER_TEMP_IO_FAILED", "Local speech synthesis could not protect its wave file", false)
+	}
+	wavePath := waveFile.Name()
+	waveWriter := &localPassportTTSBoundedWriter{writer: waveFile, limit: maxPassportTTSWaveBytes}
+	var waveErr error
+	switch config.engine {
+	case "local-espeak":
+		waveArgs := []string{"--stdin", "--stdout", "-v", "cmn"}
+		waveErr = runLocalPassportTTSStep(requestCtx, config, config.espeakPath, waveArgs, strings.NewReader(text), waveWriter, tempDir)
+	case "local-sherpa":
+		waveArgs := []string{"-I", config.sherpaScriptPath}
+		waveErr = runLocalPassportTTSStep(requestCtx, config, config.sherpaPythonPath, waveArgs, strings.NewReader(text), waveWriter, tempDir)
+	default:
+		return nil, passportTTSFailure("TTS_PROVIDER_CONFIG_INVALID", "Local speech synthesis engine is unsupported", false)
+	}
+	if waveErr != nil {
+		_ = waveFile.Close()
+		return nil, waveErr
+	}
+	if err := waveFile.Sync(); err != nil {
+		_ = waveFile.Close()
+		return nil, passportTTSFailure("TTS_PROVIDER_TEMP_IO_FAILED", "Local speech synthesis wave output could not be finalized", true)
+	}
+	if err := waveFile.Close(); err != nil {
+		return nil, passportTTSFailure("TTS_PROVIDER_TEMP_IO_FAILED", "Local speech synthesis wave output could not be closed", true)
+	}
+	if waveWriter.written == 0 {
+		return nil, passportTTSFailure("TTS_PROVIDER_INVALID_RESPONSE", "Local speech synthesis returned no wave audio", false)
+	}
+
+	pcmBuffer := &bytes.Buffer{}
+	pcmWriter := &localPassportTTSBoundedWriter{writer: pcmBuffer, limit: maxPassportTTSOutputBytes}
+	ffmpegArgs := []string{"-nostdin", "-hide_banner", "-loglevel", "error", "-threads", "1", "-filter_threads", "1", "-i", wavePath, "-map_metadata", "-1", "-threads", "1", "-f", "s16le", "-acodec", "pcm_s16le", "-ar", "24000", "-ac", "1", "pipe:1"}
+	if err := runLocalPassportTTSStep(requestCtx, config, config.ffmpegPath, ffmpegArgs, nil, pcmWriter, tempDir); err != nil {
+		return nil, err
+	}
+	pcm = pcmBuffer.Bytes()
+	if !validLocalPassportTTSPCM(pcm) {
+		return nil, passportTTSFailure("TTS_PROVIDER_INVALID_RESPONSE", "Local speech synthesis returned empty or invalid PCM audio", false)
+	}
+	return pcm, nil
+}
+
+func localPassportTTSCtxError(parent, request context.Context, err error) error {
+	if errors.Is(parent.Err(), context.Canceled) || errors.Is(err, context.Canceled) {
+		return context.Canceled
+	}
+	if errors.Is(parent.Err(), context.DeadlineExceeded) || errors.Is(request.Err(), context.DeadlineExceeded) || errors.Is(err, context.DeadlineExceeded) {
+		return passportTTSFailure("TTS_PROVIDER_TIMEOUT", "Local speech synthesis timed out", true)
+	}
+	return passportTTSFailure("TTS_PROVIDER_EXECUTION_FAILED", "Local speech synthesis failed", false)
+}
+
+func validLocalPassportTTSPCM(pcm []byte) bool {
+	if len(pcm) == 0 || len(pcm) > maxPassportTTSOutputBytes || len(pcm)%2 != 0 || bytes.HasPrefix(pcm, []byte("RIFF")) {
+		return false
+	}
+	return true
+}
+
+type localPassportTTSBoundedWriter struct {
+	writer   io.Writer
+	limit    int64
+	written  int64
+	cancel   context.CancelFunc
+	exceeded bool
+}
+
+func (w *localPassportTTSBoundedWriter) Write(p []byte) (int, error) {
+	remaining := w.limit - w.written
+	if remaining <= 0 {
+		w.exceeded = true
+		if w.cancel != nil {
+			w.cancel()
+		}
+		return 0, errors.New("local TTS byte budget exceeded")
+	}
+	if int64(len(p)) > remaining {
+		n, err := w.writer.Write(p[:remaining])
+		w.written += int64(n)
+		w.exceeded = true
+		if w.cancel != nil {
+			w.cancel()
+		}
+		if err != nil {
+			return n, err
+		}
+		return n, errors.New("local TTS byte budget exceeded")
+	}
+	n, err := w.writer.Write(p)
+	w.written += int64(n)
+	return n, err
+}
+
+type localPassportTTSStderr struct {
+	seen     int64
+	limit    int64
+	cancel   context.CancelFunc
+	exceeded bool
+}
+
+func (w *localPassportTTSStderr) Write(p []byte) (int, error) {
+	w.seen += int64(len(p))
+	if w.seen > w.limit {
+		w.exceeded = true
+		if w.cancel != nil {
+			w.cancel()
+		}
+	}
+	// Diagnostics are drained to avoid pipe deadlocks, never retained or exposed.
+	return len(p), nil
+}
diff --git a/internal/backend/passport_tts_local_linux.go b/internal/backend/passport_tts_local_linux.go
new file mode 100644
index 0000000..841fb08
--- /dev/null
+++ b/internal/backend/passport_tts_local_linux.go
@@ -0,0 +1,249 @@
+//go:build linux
+
+package backend
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"syscall"
+	"time"
+)
+
+const localPassportTTSMemoryBytes = uint64(4 * 1024 * 1024 * 1024)
+
+func platformPassportTTSLocalConfiguration(timeout time.Duration) (localPassportTTSConfig, error) {
+	espeak, err := validateLocalPassportTTSExecutable("/usr/bin/espeak-ng")
+	if err != nil {
+		return localPassportTTSConfig{}, passportTTSFailure("TTS_PROVIDER_NOT_CONFIGURED", "The fixed eSpeak NG executable is unavailable", false)
+	}
+	ffmpeg, err := validateLocalPassportTTSExecutable("/usr/bin/ffmpeg")
+	if err != nil {
+		return localPassportTTSConfig{}, passportTTSFailure("TTS_PROVIDER_NOT_CONFIGURED", "The fixed ffmpeg executable is unavailable", false)
+	}
+	limiter, err := localASRResourceLimiter()
+	if err != nil || limiter == "" {
+		return localPassportTTSConfig{}, passportTTSFailure("TTS_PROVIDER_CONFIG_INVALID", "Local speech synthesis requires the validated Linux prlimit launcher", false)
+	}
+	return localPassportTTSConfig{espeakPath: espeak, ffmpegPath: ffmpeg, limiterPath: limiter, timeout: timeout}, nil
+}
+
+func platformPassportTTSLocalSherpaConfiguration(timeout time.Duration) (localPassportTTSConfig, error) {
+	pythonResolved, err := validateLocalPassportTTSSherpaPython(localPassportTTSSherpaPythonPath)
+	if err != nil {
+		return localPassportTTSConfig{}, passportTTSFailure("TTS_PROVIDER_NOT_CONFIGURED", "The fixed Sherpa TTS Python environment is unavailable", false)
+	}
+	if err := validateLocalPassportTTSSherpaScript(localPassportTTSSherpaScriptPath); err != nil {
+		return localPassportTTSConfig{}, passportTTSFailure("TTS_PROVIDER_NOT_CONFIGURED", "The protected fixed Sherpa TTS script is unavailable", false)
+	}
+	ffmpeg, err := validateLocalPassportTTSExecutable("/usr/bin/ffmpeg")
+	if err != nil {
+		return localPassportTTSConfig{}, passportTTSFailure("TTS_PROVIDER_NOT_CONFIGURED", "The fixed ffmpeg executable is unavailable", false)
+	}
+	limiter, err := localASRResourceLimiter()
+	if err != nil || limiter == "" {
+		return localPassportTTSConfig{}, passportTTSFailure("TTS_PROVIDER_CONFIG_INVALID", "Local speech synthesis requires the validated Linux prlimit launcher", false)
+	}
+	return localPassportTTSConfig{
+		sherpaPythonPath:         localPassportTTSSherpaPythonPath,
+		sherpaPythonResolvedPath: pythonResolved,
+		sherpaScriptPath:         localPassportTTSSherpaScriptPath,
+		ffmpegPath:               ffmpeg,
+		limiterPath:              limiter,
+		timeout:                  timeout,
+	}, nil
+}
+
+func validateLocalPassportTTSExecutable(candidate string) (string, error) {
+	if candidate != "/usr/bin/espeak-ng" && candidate != "/usr/bin/ffmpeg" {
+		return "", errors.New("local TTS executable is outside the fixed allowlist")
+	}
+	resolved, err := filepath.EvalSymlinks(candidate)
+	if err != nil {
+		return "", err
+	}
+	abs, err := filepath.Abs(resolved)
+	if err != nil || filepath.Clean(abs) != filepath.Clean(candidate) {
+		return "", errors.New("fixed local TTS executable resolved outside its configured path")
+	}
+	info, err := os.Stat(abs)
+	if err != nil || !info.Mode().IsRegular() || info.Mode().Perm()&0111 == 0 || info.Mode().Perm()&0022 != 0 {
+		return "", errors.New("fixed local TTS executable is not a protected executable file")
+	}
+	return abs, nil
+}
+
+func validateLocalPassportTTSSherpaPython(candidate string) (string, error) {
+	if candidate != localPassportTTSSherpaPythonPath {
+		return "", errors.New("Sherpa Python launcher is outside the fixed allowlist")
+	}
+	linkInfo, err := os.Lstat(candidate)
+	if err != nil || (!linkInfo.Mode().IsRegular() && linkInfo.Mode()&os.ModeSymlink == 0) {
+		return "", errors.New("fixed Sherpa Python launcher is not a regular file or symlink")
+	}
+	if !localPassportTTSOwnedByRoot(linkInfo) || (linkInfo.Mode()&os.ModeSymlink == 0 && linkInfo.Mode().Perm()&0022 != 0) {
+		return "", errors.New("fixed Sherpa Python launcher is not root-owned and protected")
+	}
+	if err := validateLocalPassportTTSRootProtectedDirectories(filepath.Dir(candidate)); err != nil {
+		return "", err
+	}
+	resolved, err := filepath.EvalSymlinks(candidate)
+	if err != nil {
+		return "", err
+	}
+	abs, err := filepath.Abs(resolved)
+	if err != nil || !filepath.IsAbs(abs) || filepath.Clean(abs) != filepath.Clean(resolved) {
+		return "", errors.New("fixed Sherpa Python launcher resolved to an invalid path")
+	}
+	info, err := os.Stat(abs)
+	if err != nil || !info.Mode().IsRegular() || info.Mode().Perm()&0111 == 0 || info.Mode().Perm()&0022 != 0 || !localPassportTTSOwnedByRoot(info) {
+		return "", errors.New("resolved Sherpa Python interpreter is not a root-owned protected executable file")
+	}
+	if err := validateLocalPassportTTSRootProtectedDirectories(filepath.Dir(abs)); err != nil {
+		return "", err
+	}
+	if err := validateLocalPassportTTSSherpaPyVenvConfig(); err != nil {
+		return "", err
+	}
+	if err := validateLocalPassportTTSRootProtectedDirectories(localPassportTTSSherpaSitePackagesPath); err != nil {
+		return "", errors.New("fixed Sherpa Python site-packages directory is not root-owned and protected")
+	}
+	return filepath.Clean(abs), nil
+}
+
+func validateLocalPassportTTSSherpaScript(candidate string) error {
+	if candidate != localPassportTTSSherpaScriptPath {
+		return errors.New("Sherpa TTS script is outside the fixed allowlist")
+	}
+	info, err := os.Lstat(candidate)
+	if err != nil || !info.Mode().IsRegular() || info.Mode()&os.ModeSymlink != 0 || info.Mode().Perm()&0022 != 0 || info.Mode().Perm()&0444 == 0 || !localPassportTTSOwnedByRoot(info) {
+		return errors.New("fixed Sherpa TTS script is not a protected readable regular file")
+	}
+	if err := validateLocalPassportTTSRootProtectedDirectories(filepath.Dir(candidate)); err != nil {
+		return errors.New("fixed Sherpa TTS script has an unprotected ancestor directory")
+	}
+	return nil
+}
+
+func localPassportTTSOwnedByRoot(info os.FileInfo) bool {
+	stat, ok := info.Sys().(*syscall.Stat_t)
+	return ok && stat.Uid == 0
+}
+
+func validateLocalPassportTTSRootProtectedDirectories(directory string) error {
+	directory, err := filepath.Abs(directory)
+	if err != nil {
+		return err
+	}
+	for current := filepath.Clean(directory); ; current = filepath.Dir(current) {
+		info, statErr := os.Lstat(current)
+		if statErr != nil || !info.IsDir() || info.Mode()&os.ModeSymlink != 0 || info.Mode().Perm()&0022 != 0 || !localPassportTTSOwnedByRoot(info) {
+			return errors.New("fixed local TTS path has an unprotected root-owned directory")
+		}
+		parent := filepath.Dir(current)
+		if parent == current {
+			break
+		}
+	}
+	return nil
+}
+
+func validateLocalPassportTTSSherpaPyVenvConfig() error {
+	info, err := os.Lstat(localPassportTTSSherpaPyVenvConfigPath)
+	if err != nil || !info.Mode().IsRegular() || info.Mode()&os.ModeSymlink != 0 || info.Mode().Perm()&0022 != 0 || info.Mode().Perm()&0444 == 0 || !localPassportTTSOwnedByRoot(info) {
+		return errors.New("fixed Sherpa pyvenv.cfg is not a root-owned protected regular file")
+	}
+	if err := validateLocalPassportTTSRootProtectedDirectories(filepath.Dir(localPassportTTSSherpaPyVenvConfigPath)); err != nil {
+		return errors.New("fixed Sherpa pyvenv.cfg has an unprotected ancestor directory")
+	}
+	return nil
+}
+
+func validateLocalPassportTTSSherpaFiles(config localPassportTTSConfig) error {
+	resolved, err := validateLocalPassportTTSSherpaPython(config.sherpaPythonPath)
+	if err != nil || filepath.Clean(resolved) != filepath.Clean(config.sherpaPythonResolvedPath) {
+		return errors.New("fixed Sherpa Python environment changed after configuration")
+	}
+	if err := validateLocalPassportTTSSherpaScript(config.sherpaScriptPath); err != nil {
+		return err
+	}
+	ffmpeg, err := validateLocalPassportTTSExecutable(config.ffmpegPath)
+	if err != nil || filepath.Clean(ffmpeg) != filepath.Clean(config.ffmpegPath) {
+		return errors.New("fixed Sherpa ffmpeg executable changed after configuration")
+	}
+	return nil
+}
+
+func runLocalPassportTTSStep(ctx context.Context, config localPassportTTSConfig, executable string, argv []string, stdin io.Reader, stdout *localPassportTTSBoundedWriter, tempDir string) error {
+	if err := validateLocalPassportTTSConfig(config); err != nil {
+		return err
+	}
+	if config.engine == "local-sherpa" {
+		if err := validateLocalPassportTTSSherpaFiles(config); err != nil {
+			return passportTTSFailure("TTS_PROVIDER_CONFIG_INVALID", "A fixed Sherpa speech synthesis file could not be verified", false)
+		}
+		if executable == config.sherpaPythonPath {
+			if len(argv) != 2 || argv[0] != "-I" || argv[1] != config.sherpaScriptPath || stdin == nil {
+				return passportTTSFailure("TTS_PROVIDER_CONFIG_INVALID", "The fixed Sherpa speech synthesis command is invalid", false)
+			}
+		} else if executable != config.ffmpegPath {
+			return passportTTSFailure("TTS_PROVIDER_CONFIG_INVALID", "Local Sherpa speech synthesis executable is invalid", false)
+		}
+	} else if executable != config.espeakPath && executable != config.ffmpegPath {
+		return passportTTSFailure("TTS_PROVIDER_CONFIG_INVALID", "Local speech synthesis executable is invalid", false)
+	}
+	if executable == config.ffmpegPath || executable == config.espeakPath {
+		validated, err := validateLocalPassportTTSExecutable(executable)
+		if err != nil || filepath.Clean(validated) != filepath.Clean(executable) {
+			return passportTTSFailure("TTS_PROVIDER_CONFIG_INVALID", "A fixed local speech synthesis executable could not be verified", false)
+		}
+	}
+	limiter, err := localASRResourceLimiter()
+	if err != nil || filepath.Clean(limiter) != filepath.Clean(config.limiterPath) {
+		return passportTTSFailure("TTS_PROVIDER_CONFIG_INVALID", "Local speech synthesis requires the validated Linux prlimit launcher", false)
+	}
+	if err := ctx.Err(); err != nil {
+		return localPassportTTSCtxError(ctx, ctx, err)
+	}
+
+	stepCtx, cancel := context.WithCancel(ctx)
+	defer cancel()
+	stdout.cancel = cancel
+	stderr := &localPassportTTSStderr{limit: maxPassportTTSStderr, cancel: cancel}
+	limitedArgs := []string{
+		fmt.Sprintf("--cpu=%d:%d", maxPassportTTSLocalCPUSec, maxPassportTTSLocalCPUSec+1),
+		fmt.Sprintf("--as=%d:%d", localPassportTTSMemoryBytes, localPassportTTSMemoryBytes),
+		"--",
+		executable,
+	}
+	limitedArgs = append(limitedArgs, argv...)
+	cmd := exec.CommandContext(stepCtx, config.limiterPath, limitedArgs...)
+	cmd.Env = localPassportTTSChildEnvironment(tempDir)
+	cmd.Stdin = stdin
+	cmd.Stdout = stdout
+	cmd.Stderr = stderr
+	configureLocalASRProcessGroup(cmd)
+	runErr := cmd.Run()
+	if cmd.Process != nil {
+		if stopErr := stopLocalASRProcessGroup(cmd.Process.Pid); stopErr != nil && runErr == nil {
+			runErr = errors.New("local TTS process group could not be stopped")
+		}
+	}
+	if stdout.exceeded {
+		return passportTTSFailure("TTS_PROVIDER_INVALID_RESPONSE", "Local speech synthesis output exceeds the byte budget", false)
+	}
+	if stderr.exceeded {
+		return passportTTSFailure("TTS_PROVIDER_EXECUTION_FAILED", "Local speech synthesis exceeded its diagnostic output budget", false)
+	}
+	if ctx.Err() != nil {
+		return localPassportTTSCtxError(ctx, ctx, ctx.Err())
+	}
+	if runErr != nil {
+		return passportTTSFailure("TTS_PROVIDER_EXECUTION_FAILED", "Local speech synthesis failed", false)
+	}
+	return nil
+}
diff --git a/internal/backend/passport_tts_local_linux_test.go b/internal/backend/passport_tts_local_linux_test.go
