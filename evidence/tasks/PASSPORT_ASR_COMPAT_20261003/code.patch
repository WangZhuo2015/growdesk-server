+
+	clearPassportTTSTestEnv(t)
+	if _, err := passportTTSConfiguration(nativeProviderConfig{Mode: "openai-compatible", Endpoint: "https://provider.invalid/v1/chat/completions", APIKey: "test_fake_key"}); err == nil {
