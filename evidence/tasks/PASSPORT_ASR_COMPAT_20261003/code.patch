+++ b/internal/backend/asr_configuration_test.go
@@ -0,0 +1,145 @@
+package backend
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+func clearSpeechTestEnvironment(t *testing.T) {
+	t.Helper()
+	for _, name := range []string{
+		"ASR_COMMAND", "GROWDESK_ASR_PROVIDER", "GROWDESK_ASR_BASE_URL", "GROWDESK_ASR_API_KEY", "GROWDESK_ASR_MODEL", "GROWDESK_ASR_TIMEOUT_MS",
+		"GROWDESK_AI_PROVIDER", "GROWDESK_AI_BASE_URL", "GROWDESK_AI_API_KEY", "GROWDESK_AI_MODEL", "GROWDESK_AI_TIMEOUT_MS",
+		"GROWDESK_AI_FIXTURE_RESPONSE", "GROWDESK_AI_FIXTURE_TEXT", "GROWDESK_ASR_FIXTURE_TEXT",
+		"AI_BASE_URL", "AI_API_KEY", "AI_MODEL", "OPENAI_BASE_URL", "OPENAI_API_KEY", "OPENAI_MODEL", "OPENROUTER_API_KEY", "OPENROUTER_MODEL",
+	} {
+		t.Setenv(name, "")
+	}
+}
+
+func TestSpeechMissingConfigurationDoesNotInventTranscript(t *testing.T) {
+	clearSpeechTestEnvironment(t)
+	_, err := nativeSpeechConfiguration()
+	var failure *nativeProviderError
+	if !errors.As(err, &failure) || failure.Code != "ASR_PROVIDER_NOT_CONFIGURED" {
+		t.Fatalf("missing speech configuration = %v, want explicit ASR_PROVIDER_NOT_CONFIGURED", err)
+	}
+}
+
+func TestPassportSpeechCanTranscribeBeforeMissingChatConfiguration(t *testing.T) {
+	clearSpeechTestEnvironment(t)
+	calls := 0
+	provider := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		calls++
+		if r.URL.Path != "/v1/audio/transcriptions" || r.Header.Get("Authorization") != "Bearer test_asr_key" {
+			t.Errorf("unexpected isolated ASR request %s", r.URL.Path)
+		}
+		_, _ = io.WriteString(w, `{"text":"test spoken text"}`)
+	}))
+	defer provider.Close()
+	t.Setenv("GROWDESK_ASR_PROVIDER", "openai-compatible")
+	t.Setenv("GROWDESK_ASR_BASE_URL", provider.URL+"/v1/audio/transcriptions")
+	t.Setenv("GROWDESK_ASR_API_KEY", "test_asr_key")
+	var events []Object
+	// A nil DB proves this missing-chat path cannot reach a history/record write.
+	(&Server{}).processVoiceTurn(context.Background(), nil, "", "", "test_turn", []byte("test wav"),
+		func(raw any) error { events = append(events, raw.(Object)); return nil },
+		func([]byte) error { t.Fatal("unexpected TTS on a missing chat configuration"); return nil },
+		&passportPlaybackControl{}, nil, &passportPending[pendingCardProposal]{})
+	if calls != 1 || len(events) != 2 || events[0]["type"] != "asr.final" || events[0]["text"] != "test spoken text" ||
+		events[1]["code"] != "AI_PROVIDER_NOT_CONFIGURED" {
+		t.Fatalf("speech/chat separation: calls=%d events=%#v", calls, events)
+	}
+}
+
+func TestPassportCancelledVoiceCannotEmitStaleProviderErrors(t *testing.T) {
+	clearSpeechTestEnvironment(t)
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	(&Server{}).processVoiceTurn(ctx, nil, "", "", "test_old_turn", []byte("test wav"),
+		func(any) error { t.Fatal("cancelled turn emitted a stale result/error"); return nil },
+		func([]byte) error { t.Fatal("cancelled turn emitted audio"); return nil },
+		&passportPlaybackControl{}, nil, &passportPending[pendingCardProposal]{})
+}
+
+func TestSpeechExplicitHTTPConfigurationRejectsInvalidInputs(t *testing.T) {
+	for _, endpoint := range []string{"", "file:///tmp/test", "https://test:password@example.invalid/v1", "https://example.invalid/v1?key=test", "https://example.invalid/v1#test"} {
+		t.Run(endpoint, func(t *testing.T) {
+			clearSpeechTestEnvironment(t)
+			t.Setenv("GROWDESK_ASR_PROVIDER", "openai-compatible")
+			t.Setenv("GROWDESK_ASR_BASE_URL", endpoint)
+			t.Setenv("GROWDESK_ASR_API_KEY", "test_asr_key")
+			_, err := nativeSpeechConfiguration()
+			var failure *nativeProviderError
+			if !errors.As(err, &failure) || failure.Code != "ASR_PROVIDER_CONFIG_INVALID" || strings.Contains(err.Error(), "password") {
+				t.Fatalf("invalid speech config = %v", err)
+			}
+		})
+	}
+}
+
+func TestLegacyExplicitChatEnvironmentCompatibility(t *testing.T) {
+	clearSpeechTestEnvironment(t)
+	t.Setenv("AI_BASE_URL", "https://test-provider.invalid/v1")
+	t.Setenv("AI_API_KEY", "test_chat_key")
+	t.Setenv("AI_MODEL", "test_chat_model")
+	c, err := nativeProviderConfiguration()
+	if err != nil || c.Endpoint != "https://test-provider.invalid/v1/chat/completions" || c.Model != "test_chat_model" || c.APIKey != "test_chat_key" {
+		t.Fatalf("legacy explicit chat config rejected: %#v %v", c, err)
+	}
+}
+
+func TestChatKeyAloneDoesNotChooseAnUnconfiguredProvider(t *testing.T) {
+	clearSpeechTestEnvironment(t)
+	t.Setenv("AI_API_KEY", "test_chat_key")
+	_, err := nativeProviderConfiguration()
+	var failure *APIError
+	if !errors.As(err, &failure) || failure.Code != "AI_PROVIDER_NOT_CONFIGURED" {
+		t.Fatalf("a key alone chose an unconfigured provider: %v", err)
+	}
+}
+
+func TestSpeechSubmissionPreservesMissingConfiguration503(t *testing.T) {
+	err := speechSubmissionError(providerFailure("ASR_PROVIDER_NOT_CONFIGURED", "Speech is not configured", false))
+	app := normalizedError(err)
+	if app.Status != 503 || app.Code != "ASR_PROVIDER_NOT_CONFIGURED" {
+		t.Fatalf("speech preflight became an opaque error: %#v", app)
+	}
+}
+
+func TestChatConfigurationAloneDoesNotImplySpeechSupport(t *testing.T) {
+	clearSpeechTestEnvironment(t)
+	t.Setenv("GROWDESK_AI_PROVIDER", "compat")
+	t.Setenv("GROWDESK_AI_BASE_URL", "https://test-chat.invalid/v1")
+	t.Setenv("GROWDESK_AI_API_KEY", "test_chat_key")
+	_, err := nativeSpeechConfiguration()
+	var failure *nativeProviderError
+	if !errors.As(err, &failure) || failure.Code != "ASR_PROVIDER_NOT_CONFIGURED" {
+		t.Fatalf("chat-only endpoint was assumed to provide speech: %v", err)
+	}
+	t.Setenv("GROWDESK_ASR_PROVIDER", "shared")
+	c, err := nativeSpeechConfiguration()
+	if err != nil || c.Endpoint != "https://test-chat.invalid/v1/chat/completions" {
+		t.Fatalf("explicit shared speech configuration = %#v, %v", c, err)
+	}
+}
+
+func TestChatExplicitNewConfigurationWinsOverLegacy(t *testing.T) {
+	clearSpeechTestEnvironment(t)
+	t.Setenv("AI_BASE_URL", "https://test-legacy.invalid/v1")
+	t.Setenv("AI_API_KEY", "test_legacy_key")
+	t.Setenv("AI_MODEL", "test_legacy_model")
+	t.Setenv("GROWDESK_AI_PROVIDER", "compat")
+	t.Setenv("GROWDESK_AI_BASE_URL", "https://test-new.invalid/v1")
+	t.Setenv("GROWDESK_AI_API_KEY", "test_new_key")
+	t.Setenv("GROWDESK_AI_MODEL", "test_new_model")
+	c, err := nativeProviderConfiguration()
+	if err != nil || c.Endpoint != "https://test-new.invalid/v1/chat/completions" || c.Model != "test_new_model" || c.APIKey != "test_new_key" {
+		t.Fatalf("explicit new provider lost precedence: %#v %v", c, err)
+	}
+}
diff --git a/internal/backend/asr_local.go b/internal/backend/asr_local.go
new file mode 100644
index 0000000..0d81df8
--- /dev/null
+++ b/internal/backend/asr_local.go
@@ -0,0 +1,474 @@
+package backend
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"io"
+	"mime"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"time"
+	"unicode/utf8"
+)
+
+const (
+	localASRInputLimit      int64 = 25 * 1024 * 1024
+	localASROutputLimit     int   = 256 * 1024
+	localASRStderrLimit     int64 = 16 * 1024
+	localASRTimeout               = 110 * time.Second
+	localASRMaxCommandBytes       = 8 * 1024
+	localASRMaxArguments          = 64
+)
+
+var localASRSlot = make(chan struct{}, 1)
+
+// localASRConfig is built exclusively from service administrator configuration.
+// argv is tokenized once without shell expansion and contains exactly one
+// {input} marker outside argv[0]. There is deliberately no unbounded execution
+// fallback when the platform resource limiter is unavailable.
+type localASRConfig struct {
+	argv        []string
+	limiterPath string
+	timeout     time.Duration
+	inputLimit  int64
+	outputLimit int
+	stderrLimit int64
+	tempParent  string
+	childEnv    []string
+}
+
+// localASRConfiguration opts into local recognition only through an explicit
+// local selector or the legacy administrator-owned ASR_COMMAND setting.
+func localASRConfiguration() (localASRConfig, bool, error) {
+	selector := strings.ToLower(strings.TrimSpace(os.Getenv("GROWDESK_ASR_PROVIDER")))
+	rawCommand := strings.TrimSpace(os.Getenv("ASR_COMMAND"))
+	if selector == "" && rawCommand == "" {
+		return localASRConfig{}, false, nil
+	}
+
+	switch selector {
+	case "openai", "openai-compatible", "compat", "shared":
+		if rawCommand != "" {
+			return localASRConfig{}, false, localASRConfigError("ASR_COMMAND conflicts with the explicitly selected speech provider")
+		}
+		return localASRConfig{}, false, nil
+	case "", "local", "command":
+		if rawCommand == "" {
+			if selector == "" {
+				return localASRConfig{}, false, nil
+			}
+			return localASRConfig{}, false, providerFailure("ASR_PROVIDER_NOT_CONFIGURED", "Configure ASR_COMMAND for local speech recognition", false)
+		}
+	default:
+		return localASRConfig{}, false, localASRConfigError("GROWDESK_ASR_PROVIDER has an unsupported value")
+	}
+
+	argv, err := parseLocalASRCommand(rawCommand)
+	if err != nil {
+		return localASRConfig{}, false, err
+	}
+	program, err := resolveLocalASRProgram(argv)
+	if err != nil {
+		return localASRConfig{}, false, err
+	}
+	argv[0] = program
+	limiterPath, err := localASRResourceLimiter()
+	if err != nil {
+		return localASRConfig{}, false, err
+	}
+	return localASRConfig{
+		argv:        argv,
+		limiterPath: limiterPath,
+		timeout:     localASRTimeout,
+		inputLimit:  localASRInputLimit,
+		outputLimit: localASROutputLimit,
+		stderrLimit: localASRStderrLimit,
+		childEnv:    localASRChildEnvironment(),
+	}, true, nil
+}
+
+func localASRConfigError(message string) error {
+	return providerFailure("ASR_PROVIDER_CONFIG_INVALID", message, false)
+}
+
+// parseLocalASRCommand implements only a small argument-vector quoting syntax.
+// It does not expand variables, globs, redirects, pipes, substitutions, or
+// other shell syntax. Shell executables and a shell -c command are rejected;
+// an administrator may instead configure an executable wrapper script.
+func parseLocalASRCommand(raw string) ([]string, error) {
+	if len(raw) == 0 || len(raw) > localASRMaxCommandBytes || !utf8.ValidString(raw) || strings.ContainsAny(raw, "\x00\r\n") {
+		return nil, localASRConfigError("ASR_COMMAND is empty or exceeds its configuration budget")
+	}
+	var argv []string
+	var token strings.Builder
+	var quote rune
+	escaped := false
+	started := false
+	appendToken := func() error {
+		if !started {
+			return nil
+		}
+		argv = append(argv, token.String())
+		token.Reset()
+		started = false
+		if len(argv) > localASRMaxArguments {
+			return localASRConfigError("ASR_COMMAND has too many arguments")
+		}
+		return nil
+	}
+
+	for _, r := range raw {
+		if escaped {
+			token.WriteRune(r)
+			escaped = false
+			started = true
+			continue
+		}
+		if quote == '\'' {
+			if r == '\'' {
+				quote = 0
+			} else {
+				token.WriteRune(r)
+			}
+			started = true
+			continue
+		}
+		if quote == '"' {
+			switch r {
+			case '"':
+				quote = 0
+			case '\\':
+				escaped = true
+			default:
+				token.WriteRune(r)
+			}
+			started = true
+			continue
+		}
+		switch {
+		case r == '\'':
+			quote, started = '\'', true
+		case r == '"':
+			quote, started = '"', true
+		case r == '\\':
+			escaped, started = true, true
+		case r == ' ' || r == '\t':
+			if err := appendToken(); err != nil {
+				return nil, err
+			}
+		default:
+			token.WriteRune(r)
+			started = true
+		}
+	}
+	if escaped || quote != 0 {
+		return nil, localASRConfigError("ASR_COMMAND has unfinished quoting")
+	}
+	if err := appendToken(); err != nil {
+		return nil, err
+	}
+	if len(argv) < 2 || argv[0] == "" {
+		return nil, localASRConfigError("ASR_COMMAND requires a program and an {input} argument")
+	}
+	placeholderCount := 0
+	for i, arg := range argv {
+		count := strings.Count(arg, "{input}")
+		if i == 0 && count != 0 {
+			return nil, localASRConfigError("ASR_COMMAND cannot place {input} in the program name")
+		}
+		placeholderCount += count
+	}
+	if placeholderCount != 1 {
+		return nil, localASRConfigError("ASR_COMMAND must contain exactly one {input} argument marker")
+	}
+	if launchesShellIndirectly(argv) {
+		return nil, localASRConfigError("ASR_COMMAND must not launch a shell directly or through a command dispatcher")
+	}
+	return argv, nil
+}
+
+func isShellProgram(program string) bool {
+	switch strings.ToLower(filepath.Base(program)) {
+	case "sh", "bash", "dash", "zsh", "fish", "ksh", "csh", "tcsh", "ash":
+		return true
+	default:
+		return false
+	}
+}
+
+func launchesShellIndirectly(argv []string) bool {
+	if len(argv) == 0 {
+		return false
+	}
+	program := strings.ToLower(filepath.Base(argv[0]))
+	if isShellProgram(program) {
+		return true
+	}
+	switch program {
+	case "env":
+		for _, arg := range argv[1:] {
+			if arg == "-S" || arg == "--split-string" {
+				return true
+			}
+			if isShellProgram(arg) {
+				return true
+			}
+			first := strings.Fields(arg)
+			if len(first) > 0 && isShellProgram(first[0]) {
+				return true
+			}
+		}
+	case "busybox", "toybox", "nohup", "setsid":
+		for _, arg := range argv[1:] {
+			if isShellProgram(arg) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func resolveLocalASRProgram(argv []string) (string, error) {
+	if len(argv) == 0 {
+		return "", localASRConfigError("ASR_COMMAND program is invalid")
+	}
+	program := argv[0]
+	if program == "" || strings.HasPrefix(program, "-") || isShellProgram(program) {
+		return "", localASRConfigError("ASR_COMMAND program is invalid or is a shell")
+	}
+	if !filepath.IsAbs(program) && strings.ContainsRune(program, filepath.Separator) {
+		return "", localASRConfigError("ASR_COMMAND program paths must be absolute")
+	}
+	resolved, err := exec.LookPath(program)
+	if err != nil {
+		return "", localASRConfigError("ASR_COMMAND program is not available on the service")
+	}
+	resolved, err = filepath.Abs(resolved)
+	if err != nil {
+		return "", localASRConfigError("ASR_COMMAND program path is invalid")
+	}
+	resolved, err = filepath.EvalSymlinks(resolved)
+	if err != nil {
+		return "", localASRConfigError("ASR_COMMAND program path is invalid")
+	}
+	info, err := os.Stat(resolved)
+	if err != nil || !info.Mode().IsRegular() || info.Mode().Perm()&0111 == 0 {
+		return "", localASRConfigError("ASR_COMMAND program must be an executable file")
+	}
+	resolvedArgv := append([]string(nil), argv...)
+	resolvedArgv[0] = resolved
+	if launchesShellIndirectly(resolvedArgv) {
+		return "", localASRConfigError("ASR_COMMAND program must not resolve to a shell dispatcher")
+	}
+	return resolved, nil
+}
+
+func localASRChildEnvironment() []string {
+	path := strings.TrimSpace(os.Getenv("PATH"))
+	if path == "" {
+		path = "/usr/bin:/bin"
+	}
+	// Never inherit service credentials, provider keys, or arbitrary environment
+	// values into a local model process. Model and wrapper settings belong in the
+	// administrator's fixed argv or wrapper script.
+	return []string{"PATH=" + path, "LANG=C.UTF-8", "LC_ALL=C.UTF-8"}
+}
+
+func transcribeLocalASR(ctx context.Context, config localASRConfig, audio io.Reader, mimeType string) (transcript string, retErr error) {
+	if ctx == nil || audio == nil {
+		return "", providerFailure("ASR_PROVIDER_INVALID_INPUT", "Audio input is unavailable", false)
+	}
+	if err := ctx.Err(); err != nil {
+		return "", err
+	}
+	if err := validateLocalASRConfig(config); err != nil {
+		return "", err
+	}
+	suffix, err := localASRAudioSuffix(mimeType)
+	if err != nil {
+		return "", err
+	}
+	select {
+	case localASRSlot <- struct{}{}:
+		defer func() { <-localASRSlot }()
+	default:
+		return "", providerFailure("ASR_PROVIDER_BUSY", "Local speech recognition is busy", true)
+	}
+
+	tempDir, err := os.MkdirTemp(config.tempParent, "growdesk-asr-")
+	if err != nil {
+		return "", providerFailure("ASR_PROVIDER_TEMP_IO_FAILED", "Local speech recognition could not create a private input", true)
+	}
+	defer func() {
+		if cleanupErr := os.RemoveAll(tempDir); cleanupErr != nil {
+			transcript = ""
+			retErr = providerFailure("ASR_PROVIDER_TEMP_IO_FAILED", "Local speech recognition temporary files could not be removed", false)
+		}
+	}()
+	if err = os.Chmod(tempDir, 0700); err != nil {
+		return "", providerFailure("ASR_PROVIDER_TEMP_IO_FAILED", "Local speech recognition could not protect its input", false)
+	}
+
+	input, err := os.CreateTemp(tempDir, "input-*"+suffix)
+	if err != nil {
+		return "", providerFailure("ASR_PROVIDER_TEMP_IO_FAILED", "Local speech recognition could not create a private input", true)
+	}
+	inputPath := input.Name()
+	if err = input.Chmod(0600); err != nil {
+		_ = input.Close()
+		return "", providerFailure("ASR_PROVIDER_TEMP_IO_FAILED", "Local speech recognition could not protect its input", false)
+	}
+	written, copyErr := io.Copy(input, io.LimitReader(audio, config.inputLimit+1))
+	closeErr := input.Close()
+	if copyErr != nil || closeErr != nil {
+		return "", providerFailure("ASR_PROVIDER_TEMP_IO_FAILED", "Local speech recognition input could not be written", true)
+	}
+	if written == 0 {
+		return "", providerFailure("ASR_PROVIDER_INVALID_INPUT", "Audio input is empty", false)
+	}
+	if written > config.inputLimit {
+		return "", providerFailure("ASR_PROVIDER_INPUT_TOO_LARGE", "Audio input exceeds the local recognition budget", false)
+	}
+
+	argv := make([]string, len(config.argv))
+	copy(argv, config.argv)
+	for i := 1; i < len(argv); i++ {
+		argv[i] = strings.ReplaceAll(argv[i], "{input}", inputPath)
+	}
+
+	runCtx, cancel := context.WithTimeout(ctx, config.timeout)
+	defer cancel()
+	stdout := &localASRStdout{limit: config.outputLimit, cancel: cancel}
+	stderr := &localASRStderr{limit: config.stderrLimit, cancel: cancel}
+	env := append([]string(nil), config.childEnv...)
+	env = append(env, "TMPDIR="+tempDir)
+	runErr := runLocalASRWithLimits(runCtx, config, argv, env, stdout, stderr)
+
+	if errors.Is(ctx.Err(), context.Canceled) {
+		return "", context.Canceled
+	}
+	if errors.Is(ctx.Err(), context.DeadlineExceeded) {
+		return "", providerFailure("ASR_PROVIDER_TIMEOUT", "Local speech recognition timed out", true)
+	}
+	if stdout.exceeded {
+		return "", providerFailure("ASR_PROVIDER_INVALID_RESPONSE", "Local speech recognition output exceeds the byte budget", false)
+	}
+	if stderr.exceeded {
+		return "", providerFailure("ASR_PROVIDER_EXECUTION_FAILED", "Local speech recognizer exceeded its diagnostic output budget", false)
+	}
+	if errors.Is(runCtx.Err(), context.DeadlineExceeded) {
+		return "", providerFailure("ASR_PROVIDER_TIMEOUT", "Local speech recognition timed out", true)
+	}
+	if runErr != nil {
+		return "", providerFailure("ASR_PROVIDER_EXECUTION_FAILED", "Local speech recognition failed", false)
+	}
+	transcript = strings.TrimSpace(stdout.String())
+	if transcript == "" || !utf8.ValidString(transcript) || len(transcript) > config.outputLimit {
+		return "", providerFailure("ASR_PROVIDER_INVALID_RESPONSE", "Local speech recognizer returned no valid transcript", false)
+	}
+	if _, err := validateASRTranscript(transcript); err != nil {
+		return "", providerFailure("ASR_PROVIDER_INVALID_RESPONSE", "Local speech recognizer returned no valid transcript", false)
+	}
+	return transcript, nil
+}
+
+func validateLocalASRConfig(config localASRConfig) error {
+	if len(config.argv) < 2 || config.argv[0] == "" || config.timeout <= 0 || config.timeout > localASRTimeout ||
+		config.inputLimit <= 0 || config.inputLimit > localASRInputLimit || config.outputLimit <= 0 || config.outputLimit > localASROutputLimit ||
+		config.stderrLimit <= 0 || config.stderrLimit > localASRStderrLimit {
+		return localASRConfigError("Local speech recognition configuration is invalid")
+	}
+	if config.limiterPath == "" {
+		return localASRConfigError("Local speech recognition requires a validated resource limiter")
+	}
+	count := 0
+	for i, arg := range config.argv {
+		if strings.ContainsRune(arg, '\x00') || (i == 0 && strings.Contains(arg, "{input}")) {
+			return localASRConfigError("Local speech recognition command is invalid")
+		}
+		count += strings.Count(arg, "{input}")
+	}
+	if count != 1 {
+		return localASRConfigError("Local speech recognition command must contain one input marker")
+	}
+	return nil
+}
+
+func localASRAudioSuffix(raw string) (string, error) {
+	mediaType, _, err := mime.ParseMediaType(strings.TrimSpace(raw))
+	if err != nil {
+		return "", providerFailure("ASR_PROVIDER_INVALID_INPUT", "Voice input is not a supported audio format", false)
+	}
+	suffixes := map[string]string{
+		"audio/m4a":   ".m4a",
+		"audio/mp4":   ".mp4",
+		"audio/mpeg":  ".mp3",
+		"audio/wav":   ".wav",
+		"audio/x-wav": ".wav",
+	}
+	if suffix, ok := suffixes[strings.ToLower(mediaType)]; ok {
+		return suffix, nil
+	}
+	return "", providerFailure("ASR_PROVIDER_INVALID_INPUT", "Voice input is not a supported audio format", false)
+}
+
+type localASRStdout struct {
+	bytes.Buffer
+	limit    int
+	cancel   context.CancelFunc
+	exceeded bool
+}
+
+func (w *localASRStdout) Write(p []byte) (int, error) {
+	remaining := w.limit - w.Len()
+	if remaining <= 0 {
+		w.exceeded = true
+		w.cancel()
+		return 0, errors.New("local ASR stdout byte budget exceeded")
+	}
+	if len(p) > remaining {
+		_, _ = w.Buffer.Write(p[:remaining])
+		w.exceeded = true
+		w.cancel()
+		return remaining, errors.New("local ASR stdout byte budget exceeded")
+	}
+	return w.Buffer.Write(p)
+}
+
+type localASRStderr struct {
+	limit    int64
+	seen     int64
+	cancel   context.CancelFunc
+	exceeded bool
+}
+
+func (w *localASRStderr) Write(p []byte) (int, error) {
+	w.seen += int64(len(p))
+	if w.seen > w.limit {
+		w.exceeded = true
+		w.cancel()
+	}
+	// Drain but never retain or expose diagnostic output.
+	return len(p), nil
+}
+
+func runLocalASRProcess(ctx context.Context, argv, env []string, stdout, stderr io.Writer) error {
+	if len(argv) == 0 || argv[0] == "" {
+		return errors.New("empty local ASR argv")
+	}
+	cmd := exec.CommandContext(ctx, argv[0], argv[1:]...)
+	cmd.Env = append([]string(nil), env...)
+	cmd.Stdout = stdout
+	cmd.Stderr = stderr
+	configureLocalASRProcessGroup(cmd)
+	runErr := cmd.Run()
+	if cmd.Process != nil {
+		if err := stopLocalASRProcessGroup(cmd.Process.Pid); err != nil && runErr == nil {
+			return errors.New("local ASR process group could not be stopped")
+		}
+	}
+	return runErr
+}
diff --git a/internal/backend/asr_local_linux.go b/internal/backend/asr_local_linux.go
new file mode 100644
index 0000000..24660de
--- /dev/null
+++ b/internal/backend/asr_local_linux.go
@@ -0,0 +1,52 @@
+//go:build linux
+
+package backend
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+const (
+	localASRCPUSeconds  = 110
+	localASRMemoryBytes = uint64(4 * 1024 * 1024 * 1024)
+)
+
+func localASRResourceLimiter() (string, error) {
+	for _, candidate := range []string{"/usr/bin/prlimit", "/bin/prlimit"} {
+		resolved, err := filepath.EvalSymlinks(candidate)
+		if err != nil {
+			continue
+		}
+		info, err := os.Stat(resolved)
+		if err != nil || !info.Mode().IsRegular() || info.Mode().Perm()&0111 == 0 {
+			continue
+		}
+		if !strings.HasSuffix(filepath.Base(resolved), "prlimit") {
+			continue
+		}
+		return resolved, nil
+	}
+	return "", localASRConfigError("Local speech recognition requires the validated Linux prlimit launcher")
+}
+
+func runLocalASRWithLimits(ctx context.Context, config localASRConfig, argv, env []string, stdout, stderr io.Writer) error {
+	limiter, err := localASRResourceLimiter()
+	if err != nil || config.limiterPath == "" || filepath.Clean(limiter) != filepath.Clean(config.limiterPath) {
+		return localASRConfigError("Local speech recognition requires the validated Linux prlimit launcher")
+	}
+	limitedArgv := make([]string, 0, len(argv)+5)
+	limitedArgv = append(limitedArgv,
+		config.limiterPath,
+		fmt.Sprintf("--cpu=%d:%d", localASRCPUSeconds, localASRCPUSeconds+1),
+		fmt.Sprintf("--as=%d:%d", localASRMemoryBytes, localASRMemoryBytes),
+		"--",
+		argv[0],
+	)
+	limitedArgv = append(limitedArgv, argv[1:]...)
+	return runLocalASRProcess(ctx, limitedArgv, env, stdout, stderr)
+}
diff --git a/internal/backend/asr_local_linux_test.go b/internal/backend/asr_local_linux_test.go
new file mode 100644
index 0000000..12e7f31
--- /dev/null
+++ b/internal/backend/asr_local_linux_test.go
@@ -0,0 +1,294 @@
+//go:build linux && !race
+
+package backend
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"syscall"
+	"testing"
+	"time"
+)
+
+const (
+	localASRChildEnabled = "GROWDESK_LOCAL_ASR_TEST_CHILD"
+	localASRChildMode    = "GROWDESK_LOCAL_ASR_TEST_MODE"
+	localASRChildMarker  = "GROWDESK_LOCAL_ASR_TEST_MARKER"
+	localASRChildPIDFile = "GROWDESK_LOCAL_ASR_TEST_PID_FILE"
+	localASRChildAudio   = "GROWDESK_LOCAL_ASR_TEST_EXPECTED_AUDIO"
+)
+
+// This process is invoked only by the isolated tests below. It receives
+// virtual audio and a deliberately minimal environment; it never loads a model
+// or talks to an external service.
+func TestLocalASRHelperProcess(t *testing.T) {
+	if os.Getenv(localASRChildEnabled) != "1" {
+		return
+	}
+	inputPath := os.Args[len(os.Args)-1]
+	switch os.Getenv(localASRChildMode) {
+	case "success":
+		info, err := os.Stat(inputPath)
+		if err != nil || info.Mode().Perm() != 0600 {
+			os.Exit(31)
+		}
+		data, err := os.ReadFile(inputPath)
+		if err != nil || string(data) != os.Getenv(localASRChildAudio) {
+			os.Exit(32)
+		}
+		dirInfo, err := os.Stat(filepath.Dir(inputPath))
+		if err != nil || dirInfo.Mode().Perm() != 0700 {
+			os.Exit(33)
+		}
+		if os.Getenv("OPENAI_API_KEY") != "" || os.Getenv("GROWDESK_AI_API_KEY") != "" {
+			os.Exit(34)
+		}
+		var cpu syscall.Rlimit
+		if syscall.Getrlimit(syscall.RLIMIT_CPU, &cpu) != nil || cpu.Cur != localASRCPUSeconds || cpu.Max != localASRCPUSeconds+1 {
+			os.Exit(35)
+		}
+		var addressSpace syscall.Rlimit
+		if syscall.Getrlimit(syscall.RLIMIT_AS, &addressSpace) != nil || addressSpace.Cur != localASRMemoryBytes || addressSpace.Max != localASRMemoryBytes {
+			os.Exit(36)
+		}
+		_, _ = io.WriteString(os.Stdout, " recognized test transcript \n")
+		os.Exit(0)
+	case "empty":
+		os.Exit(0)
+	case "large-stdout":
+		_, _ = io.WriteString(os.Stdout, strings.Repeat("x", 64*1024))
+		os.Exit(0)
+	case "large-stderr":
+		_, _ = io.WriteString(os.Stderr, strings.Repeat("private-diagnostic-token", 4096))
+		os.Exit(0)
+	case "failure":
+		_, _ = io.WriteString(os.Stderr, "private-diagnostic-token")
+		os.Exit(7)
+	case "sleep":
+		if marker := os.Getenv(localASRChildMarker); marker != "" {
+			if err := os.WriteFile(marker, []byte("started"), 0600); err != nil {
+				os.Exit(37)
+			}
+		}
+		time.Sleep(time.Hour)
+		os.Exit(0)
+	case "spawn":
+		helper, err := os.Executable()
+		if err != nil {
+			os.Exit(38)
+		}
+		marker := os.Getenv(localASRChildMarker)
+		childEnv := []string{
+			"PATH=/usr/bin:/bin",
+			"LANG=C.UTF-8",
+			localASRChildEnabled + "=1",
+			localASRChildMode + "=sleep",
+			localASRChildMarker + "=" + marker + ".child",
+		}
+		child := exec.Command(helper, "-test.run=^TestLocalASRHelperProcess$", inputPath)
+		child.Env = childEnv
+		if err = child.Start(); err != nil {
+			os.Exit(39)
+		}
+		if err = os.WriteFile(os.Getenv(localASRChildPIDFile), []byte(fmt.Sprint(child.Process.Pid)), 0600); err != nil {
+			os.Exit(40)
+		}
+		time.Sleep(time.Hour)
+		os.Exit(0)
+	default:
+		os.Exit(41)
+	}
+}
+
+func TestTranscribeLocalASRUsesProductionPrlimitWithControlledHelper(t *testing.T) {
+	t.Setenv("OPENAI_API_KEY", "test-only-key-not-a-real-secret")
+	t.Setenv("GROWDESK_AI_API_KEY", "test-only-key-not-a-real-secret")
+	config := localASRLinuxTestConfig(t, "success")
+	transcript, err := transcribeLocalASR(context.Background(), config, strings.NewReader("virtual-audio-fixture"), "audio/wav; rate=16000")
+	if err != nil || transcript != "recognized test transcript" {
+		t.Fatalf("transcript = %q, err %v", transcript, err)
+	}
+	assertLocalASRTempParentEmpty(t, config.tempParent)
+}
+
+func TestTranscribeLocalASRRejectsEmptyOversizedInputAndBadMIME(t *testing.T) {
+	config := localASRLinuxTestConfig(t, "success")
+	if _, err := transcribeLocalASR(context.Background(), config, strings.NewReader(""), "audio/wav"); !hasLocalASRCode(err, "ASR_PROVIDER_INVALID_INPUT") {
+		t.Fatalf("empty audio error = %v", err)
+	}
+
+	config = localASRLinuxTestConfig(t, "success")
+	config.inputLimit = 8
+	if _, err := transcribeLocalASR(context.Background(), config, strings.NewReader("0123456789"), "audio/wav"); !hasLocalASRCode(err, "ASR_PROVIDER_INPUT_TOO_LARGE") {
+		t.Fatalf("oversized audio error = %v", err)
+	}
+	assertLocalASRTempParentEmpty(t, config.tempParent)
+
+	config = localASRLinuxTestConfig(t, "success")
+	if _, err := transcribeLocalASR(context.Background(), config, strings.NewReader("virtual-audio"), "application/octet-stream"); !hasLocalASRCode(err, "ASR_PROVIDER_INVALID_INPUT") {
+		t.Fatalf("bad MIME error = %v", err)
+	}
+	assertLocalASRTempParentEmpty(t, config.tempParent)
+}
+
+func TestTranscribeLocalASRRejectsEmptyOversizedAndFailedOutputWithoutLeak(t *testing.T) {
+	cases := []struct {
+		name       string
+		mode       string
+		output     int
+		stderr     int64
+		wantCode   string
+		secretText string
+	}{
+		{name: "empty transcript", mode: "empty", wantCode: "ASR_PROVIDER_INVALID_RESPONSE"},
+		{name: "oversized transcript", mode: "large-stdout", output: 1024, wantCode: "ASR_PROVIDER_INVALID_RESPONSE"},
+		{name: "child failure", mode: "failure", wantCode: "ASR_PROVIDER_EXECUTION_FAILED", secretText: "private-diagnostic-token"},
+		{name: "diagnostic flood", mode: "large-stderr", stderr: 32, wantCode: "ASR_PROVIDER_EXECUTION_FAILED", secretText: "private-diagnostic-token"},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			config := localASRLinuxTestConfig(t, tc.mode)
+			if tc.output > 0 {
+				config.outputLimit = tc.output
+			}
+			if tc.stderr > 0 {
+				config.stderrLimit = tc.stderr
+			}
+			transcript, err := transcribeLocalASR(context.Background(), config, strings.NewReader("virtual-audio-fixture"), "audio/wav")
+			if transcript != "" || !hasLocalASRCode(err, tc.wantCode) {
+				t.Fatalf("transcript = %q, err %v; want code %s", transcript, err, tc.wantCode)
+			}
+			if tc.secretText != "" && strings.Contains(err.Error(), tc.secretText) {
+				t.Fatalf("child diagnostics leaked through error: %v", err)
+			}
+			assertLocalASRTempParentEmpty(t, config.tempParent)
+		})
+	}
+}
+
+func TestTranscribeLocalASRTimeoutKillsChildAndCleansInput(t *testing.T) {
+	config := localASRLinuxTestConfig(t, "sleep")
+	config.timeout = 100 * time.Millisecond
+	transcript, err := transcribeLocalASR(context.Background(), config, strings.NewReader("virtual-audio-fixture"), "audio/wav")
+	if transcript != "" || !hasLocalASRCode(err, "ASR_PROVIDER_TIMEOUT") {
+		t.Fatalf("transcript = %q, err %v; want timeout", transcript, err)
+	}
+	assertLocalASRTempParentEmpty(t, config.tempParent)
+}
+
+func TestTranscribeLocalASRCancellationKillsProcessGroupAndRejectsOverlap(t *testing.T) {
+	config := localASRLinuxTestConfig(t, "spawn")
+	config.timeout = 5 * time.Second
+	marker := filepath.Join(config.tempParent, "child-started")
+	pidFile := filepath.Join(config.tempParent, "child.pid")
+	config.childEnv = append(config.childEnv, localASRChildMarker+"="+marker, localASRChildPIDFile+"="+pidFile)
+	ctx, cancel := context.WithCancel(context.Background())
+	result := make(chan error, 1)
+	go func() {
+		_, err := transcribeLocalASR(ctx, config, strings.NewReader("virtual-audio-fixture"), "audio/wav")
+		result <- err
+	}()
+	waitForLocalASRFile(t, marker+".child")
+	waitForLocalASRFile(t, pidFile)
+
+	second := localASRLinuxTestConfig(t, "success")
+	if _, err := transcribeLocalASR(context.Background(), second, strings.NewReader("virtual-audio-fixture"), "audio/wav"); !hasLocalASRCode(err, "ASR_PROVIDER_BUSY") {
+		t.Fatalf("overlapping local ASR error = %v; want busy", err)
+	}
+
+	pidBytes, err := os.ReadFile(pidFile)
+	if err != nil {
+		cancel()
+		t.Fatal(err)
+	}
+	var pid int
+	if _, err = fmt.Sscan(string(pidBytes), &pid); err != nil || pid <= 0 {
+		cancel()
+		t.Fatalf("invalid descendant pid %q: %v", pidBytes, err)
+	}
+	cancel()
+	select {
+	case err = <-result:
+		if !errors.Is(err, context.Canceled) {
+			t.Fatalf("canceled ASR error = %v; want context.Canceled", err)
+		}
+	case <-time.After(3 * time.Second):
+		t.Fatal("ASR cancellation did not terminate the command process group")
+	}
+	deadline := time.Now().Add(2 * time.Second)
+	for time.Now().Before(deadline) {
+		if err = syscall.Kill(pid, 0); errors.Is(err, syscall.ESRCH) {
+			break
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	if err = syscall.Kill(pid, 0); err == nil {
+		t.Fatalf("descendant process %d survived cancellation", pid)
+	}
+	_ = os.Remove(marker + ".child")
+	_ = os.Remove(pidFile)
+	assertLocalASRTempParentEmpty(t, config.tempParent)
+}
+
+func TestTranscribeLocalASRRejectsMissingLimiter(t *testing.T) {
+	config := localASRLinuxTestConfig(t, "success")
+	config.limiterPath = ""
+	if _, err := transcribeLocalASR(context.Background(), config, strings.NewReader("virtual-audio-fixture"), "audio/wav"); !hasLocalASRCode(err, "ASR_PROVIDER_CONFIG_INVALID") {
+		t.Fatalf("missing limiter error = %v; want fail-closed config error", err)
+	}
+}
+
+func localASRLinuxTestConfig(t *testing.T, mode string) localASRConfig {
+	t.Helper()
+	helper, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	limiter, err := localASRResourceLimiter()
+	if err != nil {
+		t.Fatal(err)
+	}
+	return localASRConfig{
+		argv:        []string{helper, "-test.run=^TestLocalASRHelperProcess$", "{input}"},
+		limiterPath: limiter,
+		timeout:     2 * time.Second,
+		inputLimit:  localASRInputLimit,
+		outputLimit: localASROutputLimit,
+		stderrLimit: localASRStderrLimit,
+		tempParent:  t.TempDir(),
+		childEnv: append(localASRChildEnvironment(),
+			localASRChildEnabled+"=1",
+			localASRChildMode+"="+mode,
+			localASRChildAudio+"=virtual-audio-fixture",
+		),
+	}
+}
+
+func assertLocalASRTempParentEmpty(t *testing.T, parent string) {
+	t.Helper()
+	entries, err := os.ReadDir(parent)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(entries) != 0 {
+		t.Fatalf("local ASR temporary files were not cleaned up: %v", entries)
+	}
+}
+
+func waitForLocalASRFile(t *testing.T, path string) {
+	t.Helper()
+	deadline := time.Now().Add(2 * time.Second)
+	for time.Now().Before(deadline) {
+		if _, err := os.Stat(path); err == nil {
+			return
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	t.Fatalf("controlled child did not create marker %s", filepath.Base(path))
+}
