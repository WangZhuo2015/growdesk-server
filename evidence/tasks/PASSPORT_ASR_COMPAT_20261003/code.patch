+// require a chat-provider key or an /audio/transcriptions route on a chat host.
+func nativeSpeechConfiguration() (nativeProviderConfig, error) {
+	_, enabled, err := localASRConfiguration()
+	if err != nil {
+		return nativeProviderConfig{}, err
+	}
