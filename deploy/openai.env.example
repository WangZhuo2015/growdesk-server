# Copy to a private environment file and point to your official OpenAI key file.
# Supply the same settings to the API and AI worker processes.
GROWDESK_AI_PROVIDER=openai
GROWDESK_AI_MODEL=gpt-6-luna
GROWDESK_AI_API_KEY_FILE=/home/ubuntu/Github/growdesk-server/.gpt
GROWDESK_AI_TIMEOUT_MS=60000
# No base URL is needed: the official adapter uses https://api.openai.com/v1/responses.
# Audio uses separate models on the official /v1/audio endpoints.
GROWDESK_ASR_MODEL=whisper-1
GROWDESK_TTS_MODEL=tts-1
