// Immutable legacy AI audit content.  The source payload and hashes are
// retained for reconciliation, while owner scope and private attachment
// references are explicit.  Rows without a proven owner or private object
// stay quarantined and are never exposed by an online DTO.
model AiArchiveEntry {
  id             String    @id
  sourceBatchId  String    @map("source_batch_id") @db.Char(64)
  sourceSystem   String    @map("source_system") @db.VarChar(100)
  sourceTable    String    @default("AiArchive") @map("source_table") @db.VarChar(100)
  sourceId       String    @map("source_id")
  sourceHash     String    @map("source_hash") @db.Char(64)
  kind           String    @db.VarChar(32)
  filePath       String?   @map("file_path")
  content        String?
  contentHash    String    @map("content_hash") @db.Char(64)
  byteSize       Int?      @map("byte_size")
  userId         String?   @map("user_id")
  familyId       String?   @map("family_id")
  babyId         String?   @map("baby_id")
  attachmentId   String?   @map("attachment_id")
  status         String    @default("quarantined") @db.VarChar(20)
  quarantineCode String?   @map("quarantine_code") @db.VarChar(100)
  metadata       Json?     @db.JsonB
  createdAt      DateTime  @map("created_at") @db.Timestamptz(3)

  // Mapped archive rows are immutable evidence. Owner/family/attachment
  // deletion must first run an explicit quarantine workflow; silent SET NULL
  // would leave a row marked mapped without an ACL.
  user       User?       @relation(fields: [userId], references: [id], onDelete: Restrict)
  family     Family?     @relation(fields: [familyId], references: [id], onDelete: Restrict)
  baby       Baby?       @relation(fields: [familyId, babyId], references: [familyId, id], onDelete: Restrict)
  attachment Attachment? @relation(fields: [attachmentId], references: [id], onDelete: Restrict)

  @@unique([sourceBatchId, sourceTable, sourceId], name: "uq_ai_archive_entries_source")
  @@index([familyId, babyId, createdAt(sort: Desc), id(sort: Desc)], name: "ix_ai_archive_entries_scope_created")
  @@index([kind, createdAt(sort: Desc), id(sort: Desc)], name: "ix_ai_archive_entries_kind_created")
  @@index([attachmentId], name: "ix_ai_archive_entries_attachment")
  @@index([status, createdAt(sort: Desc)], name: "ix_ai_archive_entries_status_created")
  @@map("ai_archive_entries")
  @@schema("public")
}

